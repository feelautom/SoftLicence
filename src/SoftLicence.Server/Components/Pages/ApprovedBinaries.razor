@page "/approved-binaries"
@inject IDbContextFactory<LicenseDbContext> DbFactory
@inject SoftLicence.Server.Services.AuthService Auth
@inject SoftLicence.Server.Services.ToastService Toast
@inject SoftLicence.Server.Services.TimeZoneService TZ
@using SoftLicence.Server.Data
@using Microsoft.EntityFrameworkCore

<div class="container-fluid animate-fade">
    @if (!isAuthorized)
    {
        <div class="text-center py-5">
            <h2 class="text-white">Access Denied</h2>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="mb-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Approved Binaries
                </h3>
                <p class="text-muted small mb-0">Hashes de référence FP_EXE / FP_DLL / FP_CORE — tout écart déclenche un ban immédiat.</p>
            </div>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => showAddForm = !showAddForm">
                @(showAddForm ? "Annuler" : "+ Ajouter manuellement")
            </button>
        </div>

        @if (showAddForm)
        {
            <div class="card bg-dark border-primary p-3 mb-4 animate-fade">
                <h5 class="text-primary mb-3">Ajouter un hash approuvé</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="small text-muted">Produit</label>
                        <select class="form-select form-select-sm" @bind="addProductId">
                            <option value="">— Sélectionner —</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small text-muted">Version</label>
                        <input class="form-control form-control-sm" @bind="addVersion" placeholder="ex: 2.1.781" />
                    </div>
                    <div class="col-md-2">
                        <label class="small text-muted">Clé</label>
                        <select class="form-select form-select-sm" @bind="addKey">
                            <option value="FP_EXE">FP_EXE</option>
                            <option value="FP_DLL">FP_DLL</option>
                            <option value="FP_CORE">FP_CORE</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted">Hash SHA256 (hex lowercase)</label>
                        <input class="form-control form-control-sm font-monospace" @bind="addHash" placeholder="ex: a3f2..." />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary btn-sm" @onclick="AddManual"
                        disabled="@(string.IsNullOrWhiteSpace(addProductId) || string.IsNullOrWhiteSpace(addVersion) || string.IsNullOrWhiteSpace(addHash))">
                        Enregistrer
                    </button>
                </div>
            </div>
        }

        @if (editingId.HasValue)
        {
            <div class="card bg-dark border-warning p-3 mb-4 animate-fade">
                <h5 class="text-warning mb-3">Remplacer le hash</h5>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="small text-muted">Nouveau hash SHA256</label>
                        <input class="form-control form-control-sm font-monospace" @bind="editHash" placeholder="Nouveau hash..." />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-warning btn-sm" @onclick="SaveEdit" disabled="@string.IsNullOrWhiteSpace(editHash)">
                            Confirmer
                        </button>
                        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => editingId = null">Annuler</button>
                    </div>
                </div>
            </div>
        }

        <div class="card bg-dark border-secondary p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small">@filtered.Count entrée(s)</span>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" style="width:180px" @bind="filterProductId" @bind:after="ApplyFilter">
                        <option value="">Tous les produits</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                    <select class="form-select form-select-sm" style="width:130px" @bind="filterKey" @bind:after="ApplyFilter">
                        <option value="">Toutes les clés</option>
                        <option value="FP_EXE">FP_EXE</option>
                        <option value="FP_DLL">FP_DLL</option>
                        <option value="FP_CORE">FP_CORE</option>
                    </select>
                    <input class="form-control form-control-sm" style="width:200px" placeholder="Filtrer version ou hash..." @bind="filterText" @bind:after="ApplyFilter" />
                </div>
            </div>

            @if (filtered.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mb-3 opacity-25"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <p class="mb-0">Aucun hash approuvé.<br><span class="small">Les baselines sont créées automatiquement dès le premier ping de chaque version.</span></p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-sm align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th>Produit</th>
                                <th>Version</th>
                                <th>Clé</th>
                                <th>Hash approuvé</th>
                                <th>Source</th>
                                <th>Enregistré le</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in filtered)
                            {
                                <tr>
                                    <td>
                                        <span class="badge border border-secondary text-info">@(productsById.TryGetValue(entry.ProductId, out var pname) ? pname : "?")</span>
                                    </td>
                                    <td><code class="text-light">@entry.Version</code></td>
                                    <td>
                                        @{
                                            var keyColor = entry.Key switch {
                                                "FP_EXE"  => "danger",
                                                "FP_DLL"  => "warning",
                                                "FP_CORE" => "info",
                                                _         => "secondary"
                                            };
                                        }
                                        <span class="badge bg-@keyColor" style="font-size:0.65rem">@entry.Key</span>
                                    </td>
                                    <td>
                                        <code class="text-success small" title="@entry.Hash">
                                            @(entry.Hash.Length > 20 ? entry.Hash[..20] + "…" : entry.Hash)
                                        </code>
                                    </td>
                                    <td>
                                        @if (entry.Source == "admin")
                                        {
                                            <span class="badge bg-primary" style="font-size:0.6rem">ADMIN</span>
                                            @if (!string.IsNullOrEmpty(entry.ApprovedBy))
                                            {
                                                <small class="text-muted ms-1">@entry.ApprovedBy</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary" style="font-size:0.6rem">AUTO</span>
                                        }
                                    </td>
                                    <td class="small text-muted text-nowrap">@TZ.ToLocal(entry.ApprovedAt).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-warning px-2 py-0 me-1"
                                                @onclick="() => StartEdit(entry)"
                                                title="Remplacer le hash">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger px-2 py-0"
                                                @onclick="() => DeleteEntry(entry.Id)"
                                                title="Supprimer (la prochaine version cliente recréera la baseline)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="m19 6-.867 12.142A2 2 0 0 1 16.138 20H7.862a2 2 0 0 1-1.995-1.858L5 6m5 0V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2"/></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isAuthorized;
    private List<ApprovedBinary> allEntries = new();
    private List<ApprovedBinary> filtered = new();
    private List<Product> products = new();
    private Dictionary<Guid, string> productsById = new();

    // Filters
    private string filterProductId = "";
    private string filterKey = "";
    private string filterText = "";

    // Add form
    private bool showAddForm;
    private string addProductId = "";
    private string addVersion = "";
    private string addKey = "FP_EXE";
    private string addHash = "";

    // Edit form
    private Guid? editingId;
    private string editHash = "";

    protected override async Task OnInitializedAsync()
    {
        isAuthorized = await Auth.IsRootAsync();
        if (!isAuthorized) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        products = await db.Products.AsNoTracking().OrderBy(p => p.Name).ToListAsync();
        productsById = products.ToDictionary(p => p.Id, p => p.Name);
        allEntries = await db.ApprovedBinaries.AsNoTracking()
            .OrderBy(b => b.ProductId).ThenBy(b => b.Version).ThenBy(b => b.Key)
            .ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = allEntries.AsEnumerable();

        if (!string.IsNullOrEmpty(filterProductId) && Guid.TryParse(filterProductId, out var pid))
            q = q.Where(b => b.ProductId == pid);

        if (!string.IsNullOrEmpty(filterKey))
            q = q.Where(b => b.Key == filterKey);

        if (!string.IsNullOrWhiteSpace(filterText))
        {
            var s = filterText.Trim().ToLowerInvariant();
            q = q.Where(b => b.Version.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                              b.Hash.Contains(s, StringComparison.OrdinalIgnoreCase));
        }

        filtered = q.ToList();
    }

    private async Task AddManual()
    {
        if (!Guid.TryParse(addProductId, out var pid)) return;
        var hash = addHash.Trim().ToLowerInvariant();
        var version = addVersion.Trim();

        await using var db = await DbFactory.CreateDbContextAsync();

        // Upsert: si déjà présent pour ce produit+version+clé, on remplace
        var existing = await db.ApprovedBinaries
            .FirstOrDefaultAsync(b => b.ProductId == pid && b.Version == version && b.Key == addKey);

        if (existing != null)
        {
            existing.Hash = hash;
            existing.Source = "admin";
            existing.ApprovedAt = DateTime.UtcNow;
            existing.ApprovedBy = "admin";
        }
        else
        {
            db.ApprovedBinaries.Add(new ApprovedBinary
            {
                ProductId = pid,
                Version = version,
                Key = addKey,
                Hash = hash,
                Source = "admin",
                ApprovedAt = DateTime.UtcNow,
                ApprovedBy = "admin"
            });
        }

        await db.SaveChangesAsync();
        Toast.ShowSuccess($"{addKey} v{version} enregistré");

        addProductId = "";
        addVersion = "";
        addHash = "";
        showAddForm = false;
        await LoadData();
    }

    private void StartEdit(ApprovedBinary entry)
    {
        editingId = entry.Id;
        editHash = entry.Hash;
    }

    private async Task SaveEdit()
    {
        if (!editingId.HasValue) return;
        var hash = editHash.Trim().ToLowerInvariant();

        await using var db = await DbFactory.CreateDbContextAsync();
        var entry = await db.ApprovedBinaries.FindAsync(editingId.Value);
        if (entry == null) return;

        entry.Hash = hash;
        entry.Source = "admin";
        entry.ApprovedAt = DateTime.UtcNow;
        entry.ApprovedBy = "admin";
        await db.SaveChangesAsync();

        Toast.ShowSuccess("Hash remplacé (source: admin)");
        editingId = null;
        editHash = "";
        await LoadData();
    }

    private async Task DeleteEntry(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entry = await db.ApprovedBinaries.FindAsync(id);
        if (entry == null) return;

        db.ApprovedBinaries.Remove(entry);
        await db.SaveChangesAsync();

        Toast.ShowSuccess("Entrée supprimée — la prochaine réception recréera la baseline automatiquement");
        await LoadData();
    }
}
