    // ── Computed properties ───────────────────────────────────────
    IEnumerable<ErrorSummaryRow> T4FilteredSummary => string.IsNullOrWhiteSpace(t4Filter)
        ? t4ErrorSummary
        : t4ErrorSummary.Where(e =>
            (e.ErrorType?.Contains(t4Filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (e.Message?.Contains(t4Filter, StringComparison.OrdinalIgnoreCase) ?? false));

    int T4TotalPages => (int)Math.Ceiling((double)t4ErrorTotal / t4PageSize);

    IEnumerable<MachineRow> T5FilteredMachines => string.IsNullOrWhiteSpace(t5Search)
        ? t5Machines
        : t5Machines.Where(m => m.HardwareId.Contains(t5Search, StringComparison.OrdinalIgnoreCase));

    IEnumerable<MachineRow> T5PagedMachines => T5FilteredMachines.Skip((t5Page - 1) * t5PageSize).Take(t5PageSize);
    int T5TotalPages => (int)Math.Ceiling((double)T5FilteredMachines.Count() / t5PageSize);

    int T7TotalPages => (int)Math.Ceiling((double)t7Total / t7PageSize);

    // ── Lifecycle ────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        isAuthorized = await Auth.HasPermissionAsync("telemetry.view");
        if (!isAuthorized) return;

        using var db = await DbFactory.CreateDbContextAsync();
        products = await db.Products.AsNoTracking().OrderBy(p => p.Name).ToListAsync();

        await LoadTab1();
    }

    // ── Navigation ───────────────────────────────────────────────
    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        switch (tab)
        {
            case "overview":     if (!tab1Loaded) await LoadTab1();     break;
            case "events":       if (!tab2Loaded) await LoadTab2();     break;
            case "diagnostics":  if (!tab3Loaded) await LoadTab3();     break;
            case "errors":       if (!tab4Loaded) await LoadTab4();     break;
            case "machines":     if (!tab5Loaded) await LoadTab5();     break;
            case "network":      if (!tab6Loaded) await LoadTab6();     break;
            case "explorer":     if (!tab7Loaded) await LoadTab7Page(); break;
        }
    }

    private async Task RefreshCurrentTab()
    {
        tab1Loaded = tab2Loaded = tab3Loaded = tab4Loaded = tab5Loaded = tab6Loaded = tab7Loaded = false;
        await SwitchTab(activeTab);
    }

    private async Task OnProductChanged(string value)
    {
        selectedProductId = value;
        tab1Loaded = tab2Loaded = tab3Loaded = tab4Loaded = tab5Loaded = tab6Loaded = tab7Loaded = false;
        await SwitchTab(activeTab);
    }

    private async Task SetDays(int days)
    {
        selectedDays = days;
        tab1Loaded = tab2Loaded = tab3Loaded = tab4Loaded = tab5Loaded = tab6Loaded = tab7Loaded = false;
        await SwitchTab(activeTab);
    }

    // ── Helpers ─────────────────────────────────────────────────
    private Guid? ParseProductId(string? id = null)
    {
        var src = id ?? selectedProductId;
        return !string.IsNullOrEmpty(src) && Guid.TryParse(src, out var pid) ? pid : null;
    }

    private void ShowRecord(TelemetryRecord rec) => selectedRecord = rec;

    private void ToggleJsonKey(string key) => t2ExpandedKey = t2ExpandedKey == key ? null : key;

    private void ResetMachinePage() => t5Page = 1;

    private void SetT7StartDate(string? val)
    {
        t7StartDate = DateTime.TryParse(val, out var d) ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : null;
    }

    private void SetT7EndDate(string? val)
    {
        t7EndDate = DateTime.TryParse(val, out var d) ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : null;
    }

    private void ResetExplorer()
    {
        t7Search = t7TypeFilter = t7ProductFilter = "";
        t7StartDate = t7EndDate = null;
        t7Page = 1;
        tab7Loaded = false;
        _ = LoadTab7Page();
    }

    private string GetTypeBadgeClass(TelemetryType type) => type switch
    {
        TelemetryType.Event => "bg-primary",
        TelemetryType.Diagnostic => "bg-success",
        TelemetryType.Error => "bg-danger",
        _ => "bg-secondary"
    };

    private string FormatJson(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "{}";
        try
        {
            var opts = new JsonSerializerOptions { WriteIndented = true };
            var el = JsonSerializer.Deserialize<JsonElement>(json);
            return JsonSerializer.Serialize(el, opts);
        }
        catch { return json; }
    }

    // ── Tab 1 — Vue d'ensemble ────────────────────────────────────
    private async Task LoadTab1()
    {
        tab1Loading = true;
        StateHasChanged();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var since = DateTime.UtcNow.AddDays(-selectedDays);
            var pid = ParseProductId();

            var raw = await db.TelemetryRecords.AsNoTracking()
                .Where(r => r.Timestamp >= since && (pid == null || r.ProductId == pid))
                .Select(r => new { r.Timestamp, r.Type, r.HardwareId, r.ClientIp, r.Isp, r.Version })
                .ToListAsync();

            t1EventCount = raw.Count(r => r.Type == TelemetryType.Event);
            t1DiagCount  = raw.Count(r => r.Type == TelemetryType.Diagnostic);
            t1ErrorCount = raw.Count(r => r.Type == TelemetryType.Error);
            t1TotalRecords = raw.Count;

            t1UniqueHwids    = raw.Select(r => r.HardwareId).Distinct().Count();
            t1UniqueIps      = raw.Where(r => r.ClientIp != null).Select(r => r.ClientIp).Distinct().Count();
            t1UniqueIsps     = raw.Where(r => r.Isp != null).Select(r => r.Isp).Distinct().Count();
            t1UniqueVersions = raw.Where(r => r.Version != null).Select(r => r.Version).Distinct().Count();

            t1DailyVolume = raw
                .GroupBy(r => r.Timestamp.Date)
                .OrderBy(g => g.Key)
                .Select(g => new DayVolume(
                    g.Key,
                    g.Count(r => r.Type == TelemetryType.Event),
                    g.Count(r => r.Type == TelemetryType.Diagnostic),
                    g.Count(r => r.Type == TelemetryType.Error)))
                .ToList();

            t1DailyDevices = raw
                .GroupBy(r => r.Timestamp.Date)
                .OrderBy(g => g.Key)
                .Select(g => new DayCount(g.Key, g.Select(r => r.HardwareId).Distinct().Count()))
                .ToList();
        }
        finally
        {
            tab1Loading = false;
            tab1Loaded  = true;
        }
    }

    // ── Tab 2 — Événements & JSON ─────────────────────────────────
    private async Task LoadTab2()
    {
        tab2Loading = true;
        StateHasChanged();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var since = DateTime.UtcNow.AddDays(-selectedDays);
            var pid = ParseProductId();

            var events = await db.TelemetryRecords.AsNoTracking()
                .Where(r => r.Timestamp >= since &&
                            r.Type == TelemetryType.Event &&
                            (pid == null || r.ProductId == pid))
                .Include(r => r.EventData)
                .Select(r => new { r.EventName, Json = r.EventData != null ? r.EventData.PropertiesJson : null })
                .ToListAsync();

            t2TotalEvents = events.Count;

            t2EventNames = events
                .GroupBy(e => e.EventName ?? "")
                .Select(g => new EventNameRow(g.Key, g.Count()))
                .OrderByDescending(e => e.Count)
                .ToList();

            // JSON Key Explorer
            var allProps = new Dictionary<string, List<string>>();
            foreach (var ev in events.Where(e => e.Json != null))
            {
                try
                {
                    var dict = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(ev.Json!);
                    if (dict == null) continue;
                    foreach (var (k, v) in dict)
                    {
                        if (!allProps.ContainsKey(k)) allProps[k] = new();
                        allProps[k].Add(v.ToString());
                    }
                }
                catch { }
            }

            t2JsonKeys = allProps
                .Select(kv => new JsonKeyRow(kv.Key, kv.Value.Count, kv.Value))
                .OrderByDescending(x => x.Appearances)
                .ToList();

            // Auto-detect OS
            if (allProps.TryGetValue("OS", out var osVals))
                t2OsDistrib = osVals.GroupBy(v => v).ToDictionary(g => g.Key, g => g.Count());

            // Auto-detect Culture
            if (allProps.TryGetValue("Culture", out var culVals))
                t2CultureDistrib = culVals.GroupBy(v => v).ToDictionary(g => g.Key, g => g.Count());

            // FP_* keys
            t2FpKeys = allProps
                .Where(kv => kv.Key.StartsWith("FP_", StringComparison.OrdinalIgnoreCase))
                .ToDictionary(kv => kv.Key, kv => kv.Value.Count);

            // Quota_* keys
            t2QuotaKeys = allProps
                .Where(kv => kv.Key.StartsWith("Quota_", StringComparison.OrdinalIgnoreCase))
                .Select(kv =>
                {
                    var rates = new List<double>();
                    string sample = kv.Value.FirstOrDefault() ?? "";
                    foreach (var val in kv.Value)
                    {
                        var parts = val.Split('/');
                        if (parts.Length == 2 &&
                            double.TryParse(parts[0], out var used) &&
                            double.TryParse(parts[1], out var limit) &&
                            limit > 0)
                        {
                            rates.Add(used / limit * 100.0);
                        }
                    }
                    var avg = rates.Count > 0 ? rates.Average() : 0;
                    return new QuotaKeyRow(kv.Key, sample, avg);
                })
                .OrderByDescending(q => q.AvgRate)
                .ToList();
        }
        finally
        {
            tab2Loading = false;
            tab2Loaded  = true;
        }
    }

    // ── Tab 3 — Diagnostics ───────────────────────────────────────
    private async Task LoadTab3()
    {
        tab3Loading = true;
        StateHasChanged();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var since = DateTime.UtcNow.AddDays(-selectedDays);
            var pid = ParseProductId();

            var moduleRaw = await db.TelemetryDiagnosticResults.AsNoTracking()
                .Where(r => r.Diagnostic!.Record!.Timestamp >= since &&
                            (pid == null || r.Diagnostic!.Record!.ProductId == pid))
                .Select(r => new { r.ModuleName, r.Success })
                .ToListAsync();

            t3Modules = moduleRaw
                .GroupBy(r => r.ModuleName ?? "Unknown")
                .Select(g => new ModuleRow(g.Key, g.Count(), g.Count(r => r.Success)))
                .OrderByDescending(m => m.Total)
                .ToList();

            var scores = await db.TelemetryDiagnostics.AsNoTracking()
                .Where(d => d.Record!.Timestamp >= since &&
                            (pid == null || d.Record!.ProductId == pid))
                .Select(d => d.Score)
                .ToListAsync();

            t3ScoreBuckets = new int[10];
            foreach (var s in scores)
                t3ScoreBuckets[Math.Min(9, s / 10)]++;

            var portRaw = await db.TelemetryDiagnosticPorts.AsNoTracking()
                .Where(p => p.Diagnostic!.Record!.Timestamp >= since &&
                            (pid == null || p.Diagnostic!.Record!.ProductId == pid))
                .Select(p => new { p.ExternalPort, p.Name, p.Protocol })
                .ToListAsync();

            t3Ports = portRaw
                .GroupBy(p => new { p.ExternalPort, p.Name, p.Protocol })
                .Select(g => new PortRow(g.Key.ExternalPort, g.Key.Name, g.Key.Protocol, g.Count()))
                .OrderByDescending(p => p.Count)
                .Take(20)
                .ToList();

            t3TcpCount = portRaw.Count(p => "TCP".Equals(p.Protocol, StringComparison.OrdinalIgnoreCase));
            t3UdpCount = portRaw.Count(p => "UDP".Equals(p.Protocol, StringComparison.OrdinalIgnoreCase));
        }
        finally
        {
            tab3Loading = false;
            tab3Loaded  = true;
        }
    }

    // ── Tab 4 — Erreurs ───────────────────────────────────────────
    private async Task LoadTab4()
    {
        tab4Loading = true;
        StateHasChanged();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var since = DateTime.UtcNow.AddDays(-selectedDays);
            var pid = ParseProductId();

            var errorRaw = await db.TelemetryErrors.AsNoTracking()
                .Where(e => e.Record!.Timestamp >= since &&
                            (pid == null || e.Record!.ProductId == pid))
                .Select(e => new { e.ErrorType, e.Message, Ts = e.Record!.Timestamp })
                .ToListAsync();

            t4ErrorSummary = errorRaw
                .GroupBy(e => new { e.ErrorType, e.Message })
                .Select(g => new ErrorSummaryRow(g.Key.ErrorType, g.Key.Message, g.Count(), g.Max(e => e.Ts)))
                .OrderByDescending(e => e.Count)
                .ToList();

            t4DailyErrors = errorRaw
                .GroupBy(e => e.Ts.Date)
                .OrderBy(g => g.Key)
                .Select(g => new ErrDayCount(g.Key, g.Count()))
                .ToList();

            t4ErrorTotal = errorRaw.Count;
            t4ErrorPage  = 1;

            await LoadErrorBrowserPage(db, since, pid);
        }
        finally
        {
            tab4Loading = false;
            tab4Loaded  = true;
        }
    }

    private async Task GoToErrorPage(int page)
    {
        if (page < 1 || page > T4TotalPages) return;
        t4ErrorPage = page;
        using var db = await DbFactory.CreateDbContextAsync();
        var since = DateTime.UtcNow.AddDays(-selectedDays);
        await LoadErrorBrowserPage(db, since, ParseProductId());
    }

    private async Task LoadErrorBrowserPage(LicenseDbContext db, DateTime since, Guid? pid)
    {
        t4Errors = await db.TelemetryRecords.AsNoTracking().AsSplitQuery()
            .Include(r => r.ErrorData)
            .Include(r => r.Product)
            .Where(r => r.Type == TelemetryType.Error &&
                        r.Timestamp >= since &&
                        (pid == null || r.ProductId == pid))
            .OrderByDescending(r => r.Timestamp)
            .Skip((t4ErrorPage - 1) * t4PageSize)
            .Take(t4PageSize)
            .ToListAsync();
    }

    // ── Tab 5 — Machines ──────────────────────────────────────────
    private async Task LoadTab5()
    {
        tab5Loading = true;
        StateHasChanged();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var since = DateTime.UtcNow.AddDays(-selectedDays);
            var pid = ParseProductId();

            var raw = await db.TelemetryRecords.AsNoTracking()
                .Where(r => r.Timestamp >= since && (pid == null || r.ProductId == pid))
                .Select(r => new { r.HardwareId, r.Type, r.Timestamp, r.Version, r.ClientIp })
                .ToListAsync();

            t5Machines = raw
                .GroupBy(r => r.HardwareId ?? "")
                .Select(g => new MachineRow(
                    g.Key,
                    g.Count(r => r.Type == TelemetryType.Event),
                    g.Count(r => r.Type == TelemetryType.Diagnostic),
                    g.Count(r => r.Type == TelemetryType.Error),
                    g.Min(r => r.Timestamp),
                    g.Max(r => r.Timestamp),
                    g.Select(r => r.Version).Distinct().Count(),
                    g.Select(r => r.ClientIp).Distinct().Count()))
                .OrderByDescending(m => m.Events + m.Diagnostics + m.Errors)
                .ToList();

            // Build license map
            var hwids = t5Machines.Select(m => m.HardwareId).ToList();
            var licenseLinks = await db.Licenses.AsNoTracking()
                .Where(l => l.HardwareId != null && hwids.Contains(l.HardwareId))
                .Select(l => new { l.HardwareId, l.Id })
                .ToListAsync();

            t5LicenseMap = licenseLinks
                .GroupBy(l => l.HardwareId!)
                .ToDictionary(g => g.Key, g => g.First().Id);

            t5Page = 1;
        }
        finally
        {
            tab5Loading = false;
            tab5Loaded  = true;
        }
    }

    // ── Tab 6 — Réseau & ISP ──────────────────────────────────────
    private async Task LoadTab6()
    {
        tab6Loading = true;
        StateHasChanged();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var since = DateTime.UtcNow.AddDays(-selectedDays);
            var pid = ParseProductId();

            var raw = await db.TelemetryRecords.AsNoTracking()
                .Where(r => r.Timestamp >= since &&
                            (pid == null || r.ProductId == pid) &&
                            r.ClientIp != null)
                .Select(r => new { r.ClientIp, r.Isp, r.HardwareId })
                .ToListAsync();

            // ISP stats (aggregated in-memory)
            t6IspStats = raw
                .GroupBy(r => r.Isp ?? "Unknown")
                .Select(g => new IspRow(
                    g.Key,
                    g.Count(),
                    g.Select(r => r.HardwareId).Distinct().Count()))
                .OrderByDescending(x => x.Events)
                .ToList();

            // Top 50 IPs
            t6TopIps = raw
                .GroupBy(r => r.ClientIp!)
                .Select(g => new IpRow(
                    g.Key,
                    g.FirstOrDefault()?.Isp,
                    g.Count(),
                    g.Select(r => r.HardwareId).Distinct().Count()))
                .OrderByDescending(x => x.Count)
                .Take(50)
                .ToList();
        }
        finally
        {
            tab6Loading = false;
            tab6Loaded  = true;
        }
    }

    // ── Tab 7 — Explorateur brut ──────────────────────────────────
    private async Task LoadTab7Page()
    {
        tab7Loading = true;
        StateHasChanged();
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var startDate = t7StartDate ?? DateTime.UtcNow.AddDays(-selectedDays);
            var endDate   = t7EndDate.HasValue
                ? DateTime.SpecifyKind(t7EndDate.Value.AddDays(1), DateTimeKind.Utc)
                : DateTime.UtcNow;

            var query = db.TelemetryRecords.AsNoTracking().AsSplitQuery()
                .Include(r => r.Product)
                .Include(r => r.EventData)
                .Include(r => r.DiagnosticData).ThenInclude(d => d!.Results)
                .Include(r => r.DiagnosticData).ThenInclude(d => d!.Ports)
                .Include(r => r.ErrorData)
                .Where(r => r.Timestamp >= startDate && r.Timestamp <= endDate)
                .AsQueryable();

            if (!string.IsNullOrEmpty(t7TypeFilter) && Enum.TryParse<TelemetryType>(t7TypeFilter, out var ttype))
                query = query.Where(r => r.Type == ttype);

            var pid7 = ParseProductId(t7ProductFilter);
            if (pid7 != null) query = query.Where(r => r.ProductId == pid7);

            if (!string.IsNullOrWhiteSpace(t7Search))
            {
                var s = t7Search.Trim();
                query = query.Where(r =>
                    r.EventName.Contains(s) ||
                    r.HardwareId.Contains(s) ||
                    (r.Version != null && r.Version.Contains(s)) ||
                    (r.ClientIp != null && r.ClientIp.Contains(s)) ||
                    (r.Isp != null && r.Isp.Contains(s)));
            }

            t7Total   = await query.CountAsync();
            t7Records = await query
                .OrderByDescending(r => r.Timestamp)
                .Skip((t7Page - 1) * t7PageSize)
                .Take(t7PageSize)
                .ToListAsync();

            tab7Loaded = true;
        }
        finally
        {
            tab7Loading = false;
        }
    }
