}

<style>
    .ai-report { font-size: .9rem; line-height: 1.7; color: #e0e0e0; }
    .ai-report h2 { font-size: 1.1rem; color: #ffc107; border-bottom: 1px solid #444; padding-bottom: .3rem; margin-top: 1.2rem; margin-bottom: .6rem; }
    .ai-report h3 { font-size: 1rem; color: #adb5bd; margin-top: .9rem; margin-bottom: .4rem; }
    .ai-report strong { color: #fff; }
    .ai-report ul { padding-left: 1.2rem; }
    .ai-report li { margin-bottom: .2rem; }
    .ai-report hr { border-color: #444; margin: 1rem 0; }
    .ai-report code { color: #0dcaf0; background: rgba(13,202,240,.1); padding: .1rem .3rem; border-radius: .2rem; font-size: .85rem; }
</style>

@code {
    [Parameter] public Guid LicenseId { get; set; }

    private bool isAuthorized;
    private License? license;
    private List<string> hardwareIds = new();
    private List<TelemetryRecord> Records = new();
    private Guid? ExpandedRecordId;

    private string FilterType = "";
    private string? FilterHardwareId;

    // KPIs
    private int eventCount, diagnosticCount, errorCount, systemNoiseEventCount;
    private DateTime? firstActivity, lastActivity;

    // Quotas
    private Dictionary<string, List<QuotaDayData>> quotaData = new();
    // Daily usage (paid licenses)
    private const int DailyUsageWindowDays = 30;
    private List<DailyUsageData> dailyUsage = new();
    private int dailyUsageWindowOffset;
    private DateTime DailyUsageWindowEnd => SoftLicence.Server.Services.TimeZoneService.ParisDateDaysAgo(dailyUsageWindowOffset * DailyUsageWindowDays);
    private DateTime DailyUsageWindowStart => DailyUsageWindowEnd.AddDays(-(DailyUsageWindowDays - 1));
    private DateTime DailyUsageMinDate => SoftLicence.Server.Services.TimeZoneService.ToParisDate(license?.ActivationDate ?? license?.CreationDate ?? DateTime.UtcNow);
    private bool CanGoPreviousDailyUsageWindow => DailyUsageWindowEnd.AddDays(-DailyUsageWindowDays) >= DailyUsageMinDate;
    private bool CanGoNextDailyUsageWindow => dailyUsageWindowOffset > 0;
    // Cluster info
    private ClusterInfo? clusterInfo;
    private bool isFreemium => license?.Type?.Slug?.Contains("FREEMIUM", StringComparison.OrdinalIgnoreCase) == true;
    private bool isSchool => license?.Type?.Slug?.Contains("SCHOOL", StringComparison.OrdinalIgnoreCase) == true;
    private bool hasQuotas => isFreemium || isSchool;

    private static string MaskedSecret() => "****-****-****";

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Toast.ShowInfo(L["Common_Copied"]);
    }

    private bool IsSensitiveTelemetryField(string key, string value)
    {
        var normalizedKey = NormalizeSensitiveFieldName(key);
        var isSensitiveName = normalizedKey is "key" or "licensekey" or "licencekey" or "apikey" or "publickey" or "privatekey"
            || normalizedKey.EndsWith("licensekey", StringComparison.Ordinal)
            || normalizedKey.EndsWith("licencekey", StringComparison.Ordinal)
            || normalizedKey.EndsWith("apikey", StringComparison.Ordinal)
            || normalizedKey.EndsWith("token", StringComparison.Ordinal)
            || normalizedKey.EndsWith("secret", StringComparison.Ordinal)
            || normalizedKey.EndsWith("password", StringComparison.Ordinal);

        return isSensitiveName
            || (!string.IsNullOrWhiteSpace(license?.LicenseKey)
                && string.Equals(value, license.LicenseKey, StringComparison.OrdinalIgnoreCase));
    }

    private static string NormalizeSensitiveFieldName(string value)
    {
        var sb = new StringBuilder(value.Length);
        foreach (var c in value)
        {
            if (char.IsLetterOrDigit(c))
            {
                sb.Append(char.ToLowerInvariant(c));
            }
        }

        return sb.ToString();
    }

    private class QuotaDayData
    {
        public DateTime Date { get; set; }
        public int MaxUsed { get; set; }
        public int Limit { get; set; }
    }

    private class DailyUsageData
    {
        public DateTime Date { get; set; }
        public int Count { get; set; }
    }

    // AI Analysis
    private bool aiLoading;
    private string? aiReport;
    private bool showAiModal;

    // Security section state
    private bool showSecuritySection;
    private bool secLoaded;
    private int secBanCount;
    private int secCanaryCount;
    private List<CanaryAlert> secCanaryAlerts = new();
    private List<BannedHardwareId> secHwidBans = new();
    private List<ComponentBanView> secComponentBans = new();
    private List<RelatedHwid> secRelatedHwids = new();
    private Dictionary<string, Guid> secRelatedLicenses = new();

    // Pagination
    private int CurrentPage = 1;
    private int PageSize = 25;
    private int TotalCount = 0;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    protected override async Task OnInitializedAsync()
    {
        isAuthorized = await Auth.HasPermissionAsync("telemetry.view");
        if (!isAuthorized) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        license = await db.Licenses
            .AsNoTracking()
            .Include(l => l.Product)
            .Include(l => l.Type)
            .Include(l => l.Seats)
            .FirstOrDefaultAsync(l => l.Id == LicenseId);

        if (license == null) return;

        // Collect all HardwareIds (active + historical) + legacy HardwareId
        hardwareIds = license.Seats
            .Select(s => s.HardwareId)
            .Distinct()
            .ToList();

        if (!string.IsNullOrEmpty(license.HardwareId) && !hardwareIds.Contains(license.HardwareId))
            hardwareIds.Add(license.HardwareId);

        await LoadKpis();
        if (hasQuotas)
            await LoadQuotas();
        if (!isFreemium)
            await LoadDailyUsage();
        clusterInfo = await FingerprintSvc.GetClusterForHardwareIdsAsync(hardwareIds);
        await Refresh();
    }

    private async Task LoadKpis()
    {
        if (!hardwareIds.Any()) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.TelemetryRecords.AsNoTracking()
            .Where(t => hardwareIds.Contains(t.HardwareId));

        if (license!.ProductId != Guid.Empty)
            query = query.Where(t => t.ProductId == license.ProductId);

        var events = await query
            .Where(t => t.Type == TelemetryType.Event)
            .Select(t => new { t.EventName, t.Timestamp })
            .ToListAsync();

        var realActivityEvents = events
            .Where(e => TelemetrySchemaRegistry.IsRealUserActivityEvent(e.EventName))
            .ToList();

        eventCount = realActivityEvents.Count;
        systemNoiseEventCount = events.Count(e => TelemetrySchemaRegistry.IsSystemNoiseEvent(e.EventName));
        diagnosticCount = await query.CountAsync(t => t.Type == TelemetryType.Diagnostic);
        errorCount = await query.CountAsync(t => t.Type == TelemetryType.Error);
        firstActivity = realActivityEvents.Count == 0 ? null : realActivityEvents.Min(e => e.Timestamp);
        lastActivity = realActivityEvents.Count == 0 ? null : realActivityEvents.Max(e => e.Timestamp);
    }

    private async Task LoadQuotas()
    {
        if (!hardwareIds.Any()) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var since = DateTime.UtcNow.AddDays(-7);

        // Récupérer les PropertiesJson des events contenant des quotas
        var query = db.TelemetryRecords.AsNoTracking()
            .Where(t => hardwareIds.Contains(t.HardwareId) && t.Type == TelemetryType.Event && t.Timestamp >= since);

        if (license!.ProductId != Guid.Empty)
            query = query.Where(t => t.ProductId == license.ProductId);

        var events = await query
            .Where(t => t.EventData != null && t.EventData.PropertiesJson != null && t.EventData.PropertiesJson.Contains("Quota_"))
            .Select(t => new { t.Timestamp, t.EventData!.PropertiesJson })
            .ToListAsync();

        if (!events.Any()) return;

        // Parse et agrège par type de quota et par jour
        var quotaTypes = new[] { "Api_Daily", "Mcp_Daily", "Copilot_Daily" };
        var result = new Dictionary<string, List<QuotaDayData>>();

        foreach (var quotaType in quotaTypes)
        {
            var key = $"Quota_{quotaType}";
            var dailyMax = new Dictionary<DateTime, (int maxUsed, int limit)>();

            foreach (var ev in events)
            {
                try
                {
                    var json = JsonSerializer.Deserialize<JsonElement>(ev.PropertiesJson!);
                    if (json.TryGetProperty(key, out var val))
                    {
                        var parts = val.GetString()?.Split('/');
                        if (parts?.Length == 2 && int.TryParse(parts[0], out var used) && int.TryParse(parts[1], out var limit))
                        {
                            var day = SoftLicence.Server.Services.TimeZoneService.ToParisDate(ev.Timestamp);
                            if (!dailyMax.ContainsKey(day) || used > dailyMax[day].maxUsed)
                                dailyMax[day] = (used, limit);
                        }
                    }
                }
                catch { }
            }

            if (dailyMax.Any())
            {
                // Remplir les jours manquants
                var days = new List<QuotaDayData>();
                for (var d = SoftLicence.Server.Services.TimeZoneService.ParisDateDaysAgo(7); d <= SoftLicence.Server.Services.TimeZoneService.ParisDateDaysAgo(0); d = d.AddDays(1))
                {
                    var limit = dailyMax.Values.FirstOrDefault().limit;
                    if (dailyMax.TryGetValue(d, out var data))
                        days.Add(new QuotaDayData { Date = d, MaxUsed = data.maxUsed, Limit = data.limit });
                    else
                        days.Add(new QuotaDayData { Date = d, MaxUsed = 0, Limit = limit });
                }
                result[quotaType.Replace("_", " ")] = days;
            }
        }

        quotaData = result;
    }

    private async Task LoadDailyUsage()
    {
        if (!hardwareIds.Any()) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var startDate = DailyUsageWindowStart;
        var endDate = DailyUsageWindowEnd;
        var startUtc = SoftLicence.Server.Services.TimeZoneService.ParisDateToUtcRange(startDate).StartUtc;
        var endUtc = SoftLicence.Server.Services.TimeZoneService.ParisDateToUtcRange(endDate).EndUtc;

        var query = db.TelemetryRecords.AsNoTracking()
            .Where(t => hardwareIds.Contains(t.HardwareId) && t.Timestamp >= startUtc && t.Timestamp < endUtc)
            .Where(t => license!.ProductId == Guid.Empty || t.ProductId == license.ProductId);

        if (FilterHardwareId != null)
            query = query.Where(t => t.HardwareId == FilterHardwareId);

        var events = await query
            .Where(t => t.Type == TelemetryType.Event)
            .Select(t => new { t.Timestamp, t.EventName })
            .ToListAsync();

        var grouped = events
            .Where(e => TelemetrySchemaRegistry.IsRealUserActivityEvent(e.EventName))
            .GroupBy(e => SoftLicence.Server.Services.TimeZoneService.ToParisDate(e.Timestamp))
            .ToDictionary(g => g.Key, g => g.Count());

        var days = new List<DailyUsageData>();
        for (var d = startDate; d <= endDate; d = d.AddDays(1))
        {
            days.Add(new DailyUsageData { Date = d, Count = grouped.GetValueOrDefault(d, 0) });
        }
        dailyUsage = days;
    }

    private async Task PreviousDailyUsageWindow()
    {
        if (!CanGoPreviousDailyUsageWindow) return;
        dailyUsageWindowOffset++;
        await LoadDailyUsage();
    }

    private async Task NextDailyUsageWindow()
    {
        if (!CanGoNextDailyUsageWindow) return;
        dailyUsageWindowOffset--;
        await LoadDailyUsage();
    }

    private async Task Refresh()
    {
        if (!hardwareIds.Any())
        {
            Records = new();
            TotalCount = 0;
            return;
        }

        await LoadDailyUsage();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.TelemetryRecords
                .AsNoTracking()
                .AsSplitQuery()
                .Include(t => t.Product)
                .Include(t => t.EventData)
                .Include(t => t.DiagnosticData).ThenInclude(d => d!.Results)
                .Include(t => t.DiagnosticData).ThenInclude(d => d!.Ports)
                .Include(t => t.ErrorData)
                .Where(t => hardwareIds.Contains(t.HardwareId));

            if (license!.ProductId != Guid.Empty)
                query = query.Where(t => t.ProductId == license.ProductId);

            if (FilterHardwareId != null)
                query = query.Where(t => t.HardwareId == FilterHardwareId);

            if (!string.IsNullOrEmpty(FilterType) && Enum.TryParse<TelemetryType>(FilterType, out var type))
                query = query.Where(t => t.Type == type);

            TotalCount = await query.CountAsync();

            if (CurrentPage > TotalPages && TotalPages > 0) CurrentPage = TotalPages;
            if (CurrentPage < 1) CurrentPage = 1;

            Records = await query.OrderByDescending(t => t.Timestamp)
                                 .Skip((CurrentPage - 1) * PageSize)
                                 .Take(PageSize)
                                 .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing user telemetry: {ex.Message}");
        }
    }

    private async Task ChangePageSize(int size)
    {
        PageSize = size;
        CurrentPage = 1;
        await Refresh();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        await Refresh();
    }

