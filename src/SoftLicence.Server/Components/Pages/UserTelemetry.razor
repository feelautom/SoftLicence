    private sealed class ComponentBanView
    {
        public DateTime BannedAt { get; init; }
        public string ComponentType { get; init; } = "";
        public string ComponentHash { get; init; } = "";
        public string Reason { get; init; } = "";
        public bool IsActive { get; init; }
        public string MatchStrength { get; init; } = "unknown";
        public string MatchSummary { get; init; } = "";
        public bool IsWeakCorrelation => MatchStrength == "weak";

        public static ComponentBanView From(BannedComponent ban, HashSet<string> matchedTypes)
        {
            var normalizedType = NormalizeComponentType(ban.ComponentType);
            var strength = GetComponentMatchStrength(normalizedType, matchedTypes);
            return new ComponentBanView
            {
                BannedAt = ban.BannedAt,
                ComponentType = ban.ComponentType,
                ComponentHash = ban.ComponentHash,
                Reason = ban.Reason,
                IsActive = ban.IsActive,
                MatchStrength = strength,
                MatchSummary = GetComponentMatchSummary(normalizedType, matchedTypes)
            };
        }
    }

    private static string NormalizeComponentType(string componentType) => componentType.Trim().ToUpperInvariant() switch
    {
        "FP_CPU" => "CPU",
        "FP_MB" => "MB",
        "FP_BIOS" => "BIOS",
        "FP_DISK" => "DISK",
        "FP_HOST" => "HOST",
        var normalized => normalized
    };

    private static string GetComponentMatchStrength(string componentType, HashSet<string> matchedTypes)
    {
        if (componentType is "FP_EXE" or "FP_DLL" or "FP_CORE")
            return "strong";

        if (componentType == "MB" && matchedTypes.SetEquals(new[] { "MB" }))
            return "weak";

        return componentType is "DISK" or "BIOS" or "CPU" or "HOST" or "MB"
            ? "medium"
            : "unknown";
    }

    private static string GetComponentMatchSummary(string componentType, HashSet<string> matchedTypes)
    {
        if (componentType == "MB" && matchedTypes.SetEquals(new[] { "MB" }))
            return "MB seul : corrélation faible, surtout en VM";

        return matchedTypes.Count > 0
            ? $"Match {string.Join("+", matchedTypes.OrderBy(t => t, StringComparer.OrdinalIgnoreCase))}"
            : $"Match {componentType}";
    }

    private async Task<string> BuildAiPrompt()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Tu es un expert en analyse de télémétrie logicielle et gestion de licences SaaS. "
            + "Analyse les données suivantes sur un utilisateur et fournis un rapport structuré en français. "
            + "Sois précis, factuel et orienté action pour l'équipe support.");
        sb.AppendLine();

        // Contexte licence
        sb.AppendLine("## Contexte licence");
        sb.AppendLine($"- Client : {license!.CustomerName} ({license.CustomerEmail ?? "email inconnu"})");
        sb.AppendLine($"- Logiciel : {license.Product?.Name ?? "?"} | Type : {license.Type?.Slug ?? "?"}");
        sb.AppendLine($"- Statut : {(license.IsActive ? "Active" : "Révoquée/Inactive")}");
        sb.AppendLine($"- Postes max : {license.MaxSeats} | Postes actifs : {hardwareIds.Count}");
        if (license.ActivationDate.HasValue)
            sb.AppendLine($"- Activation : {TZ.ToLocal(license.ActivationDate.Value):dd/MM/yyyy}");
        if (license.ExpirationDate.HasValue)
        {
            var remaining = license.ExpirationDate.Value - DateTime.UtcNow;
            sb.AppendLine($"- Expiration : {TZ.ToLocal(license.ExpirationDate.Value):dd/MM/yyyy} ({(int)remaining.TotalDays} jours restants)");
        }
        else
        {
            sb.AppendLine("- Durée : Perpétuelle");
        }
        sb.AppendLine();

        // KPIs
        sb.AppendLine("## Activité globale");
        sb.AppendLine($"- Activité réelle : {eventCount}");
        sb.AppendLine($"- Bruit système : {systemNoiseEventCount}");
        sb.AppendLine($"- Enregistrements bruts : {TotalCount}");
        sb.AppendLine($"- Diagnostics : {diagnosticCount}");
        sb.AppendLine($"- Erreurs : {errorCount}");
        if (firstActivity.HasValue)
            sb.AppendLine($"- Première activité : {TZ.ToLocal(firstActivity.Value):dd/MM/yyyy HH:mm}");
        if (lastActivity.HasValue)
            sb.AppendLine($"- Dernière activité : {TZ.ToLocal(lastActivity.Value):dd/MM/yyyy HH:mm}");
        sb.AppendLine();

        await using var db = await DbFactory.CreateDbContextAsync();

        // Top EventNames
        var topEvents = await db.TelemetryRecords.AsNoTracking()
            .Where(r => hardwareIds.Contains(r.HardwareId) && r.Type == TelemetryType.Event)
            .GroupBy(r => r.EventName)
            .Select(g => new { Name = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(25)
            .ToListAsync();

        if (topEvents.Any())
        {
            sb.AppendLine("## Événements (Top 25)");
            foreach (var ev in topEvents)
                sb.AppendLine($"- {ev.Name} : {ev.Count}x");
            sb.AppendLine();
        }

        // Versions utilisées
        var versions = await db.TelemetryRecords.AsNoTracking()
            .Where(r => hardwareIds.Contains(r.HardwareId) && r.Version != null)
            .GroupBy(r => r.Version)
            .Select(g => new { Version = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(5)
            .ToListAsync();

        if (versions.Any())
        {
            sb.AppendLine("## Versions utilisées");
            foreach (var v in versions)
                sb.AppendLine($"- v{v.Version} : {v.Count} enregistrements");
            sb.AppendLine();
        }

        // Propriétés JSON (clés fréquentes des 100 derniers events)
        var recentEventsJson = await db.TelemetryRecords.AsNoTracking()
            .Include(r => r.EventData)
            .Where(r => hardwareIds.Contains(r.HardwareId) &&
                        r.Type == TelemetryType.Event &&
                        r.EventData != null &&
                        r.EventData.PropertiesJson != null)
            .OrderByDescending(r => r.Timestamp)
            .Take(100)
            .Select(r => r.EventData!.PropertiesJson)
            .ToListAsync();

        var propSummary = new Dictionary<string, List<string>>();
        foreach (var jsonStr in recentEventsJson)
        {
            try
            {
                var dict = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(jsonStr!);
                if (dict == null) continue;
                foreach (var (k, v) in dict)
                {
                    if (!propSummary.ContainsKey(k)) propSummary[k] = new();
                    if (propSummary[k].Count < 3)
                        propSummary[k].Add(v.ToString());
                }
            }
            catch { }
        }

        if (propSummary.Any())
        {
            sb.AppendLine("## Propriétés JSON fréquentes (100 derniers événements)");
            foreach (var kv in propSummary.OrderByDescending(x => x.Value.Count).Take(30))
                sb.AppendLine($"- **{kv.Key}** : ex. {string.Join(", ", kv.Value.Distinct().Take(3))}");
            sb.AppendLine();
        }

        // Erreurs
        var errors = await db.TelemetryErrors.AsNoTracking()
            .Where(e => hardwareIds.Contains(e.Record!.HardwareId!))
            .Select(e => new { e.ErrorType, e.Message })
            .ToListAsync();

        if (errors.Any())
        {
            sb.AppendLine("## Erreurs (regroupées)");
            var errGroups = errors
                .GroupBy(e => new { e.ErrorType, e.Message })
                .Select(g => new { g.Key.ErrorType, g.Key.Message, Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .Take(10);
            foreach (var err in errGroups)
                sb.AppendLine($"- [{err.ErrorType ?? "?"}] {err.Message} ({err.Count}x)");
            sb.AppendLine();
        }

        // Diagnostics modules
        var moduleResults = await db.TelemetryDiagnosticResults.AsNoTracking()
            .Where(r => hardwareIds.Contains(r.Diagnostic!.Record!.HardwareId!))
            .Select(r => new { r.ModuleName, r.Success })
            .ToListAsync();

        if (moduleResults.Any())
        {
            sb.AppendLine("## Santé des modules diagnostics");
            foreach (var m in moduleResults
                .GroupBy(r => r.ModuleName ?? "?")
                .Select(g => new { Name = g.Key, Total = g.Count(), OK = g.Count(r => r.Success) })
                .OrderBy(m => m.Name))
            {
                var rate = m.Total > 0 ? (m.OK * 100.0 / m.Total) : 0;
                sb.AppendLine($"- {m.Name} : {m.OK}/{m.Total} ({rate:F0}% succès)");
            }
            sb.AppendLine();
        }

        // Quotas
        if (quotaData.Any())
        {
            sb.AppendLine("## Quotas (7 derniers jours)");
            foreach (var (quotaType, days) in quotaData)
            {
                var maxDay = days.OrderByDescending(d => d.MaxUsed).FirstOrDefault();
                if (maxDay != null && maxDay.Limit > 0)
                {
                    var saturation = (int)(maxDay.MaxUsed * 100.0 / maxDay.Limit);
                    sb.AppendLine($"- {quotaType} : pic={maxDay.MaxUsed}/{maxDay.Limit} ({saturation}% saturation)");
                }
            }
            sb.AppendLine();
        }

        // Fréquence d'utilisation
        if (firstActivity.HasValue && lastActivity.HasValue && eventCount > 0)
        {
            var durationDays = Math.Max(1.0, (lastActivity.Value - firstActivity.Value).TotalDays);
            sb.AppendLine("## Fréquence d'utilisation");
            sb.AppendLine($"- Durée d'activité : {(int)durationDays} jours");
            sb.AppendLine($"- Moyenne événements/jour : {(eventCount / durationDays):F1}");
            sb.AppendLine();
        }

        // Réseau
        var uniqueIpCount = await db.TelemetryRecords.AsNoTracking()
            .Where(r => hardwareIds.Contains(r.HardwareId) && r.ClientIp != null)
            .Select(r => r.ClientIp).Distinct().CountAsync();
        var uniqueIspCount = await db.TelemetryRecords.AsNoTracking()
            .Where(r => hardwareIds.Contains(r.HardwareId) && r.Isp != null)
            .Select(r => r.Isp).Distinct().CountAsync();
        sb.AppendLine("## Réseau");
        sb.AppendLine($"- IPs uniques : {uniqueIpCount}");
        sb.AppendLine($"- FAI/ISP uniques : {uniqueIspCount}");
        sb.AppendLine();

        // Signaux d'automatisation (extraits des propriétés JSON déjà collectées)
        var automationSignals = new List<string>();
        if (propSummary.TryGetValue("IsInteractive", out var interactiveVals))
        {
            var falseCount = interactiveVals.Count(v => v.Equals("False", StringComparison.OrdinalIgnoreCase));
            if (falseCount > 0) automationSignals.Add($"IsInteractive=False détecté ({falseCount}x sur 100 events récents)");
        }
        if (propSummary.TryGetValue("RequestSource", out var requestSources))
        {
            var notable = requestSources.Where(v =>
                v.Contains("MCP", StringComparison.OrdinalIgnoreCase) ||
                v.Contains("Agent", StringComparison.OrdinalIgnoreCase)).ToList();
            if (notable.Any()) automationSignals.Add($"RequestSource: {string.Join(", ", notable.Distinct().Take(3))}");
        }
        foreach (var fpKey in propSummary.Keys.Where(k => k.StartsWith("FP_")))
            automationSignals.Add($"Fingerprint technique détecté: {fpKey}");
        if (automationSignals.Any())
        {
            sb.AppendLine("## Signaux d'automatisation / intégration technique");
            foreach (var sig in automationSignals) sb.AppendLine($"- {sig}");
            sb.AppendLine();
        }

        // OS et environnement
        if (propSummary.TryGetValue("OS", out var osVals) && osVals.Any())
        {
            sb.AppendLine("## Environnement OS");
            sb.AppendLine($"- OS détectés : {string.Join(", ", osVals.Distinct().Take(5))}");
            sb.AppendLine();
        }

        // Historique de la licence (actions admin/système)
        var licenseHistory = await db.LicenseHistories.AsNoTracking()
            .Where(h => h.LicenseId == LicenseId)
            .OrderBy(h => h.Timestamp)
            .ToListAsync();

        if (licenseHistory.Any())
        {
            sb.AppendLine("## Historique de la licence");
            foreach (var h in licenseHistory)
                sb.AppendLine($"- [{TZ.ToLocal(h.Timestamp):dd/MM/yyyy HH:mm}] {h.Action} — par {h.PerformedBy ?? "?"}{(string.IsNullOrEmpty(h.Details) ? "" : $" — {h.Details}")}");
            sb.AppendLine();
        }

        // IPs bannies et threat scores associés à cet utilisateur
        var userIps = await db.TelemetryRecords.AsNoTracking()
            .Where(r => hardwareIds.Contains(r.HardwareId) && r.ClientIp != null)
            .Select(r => r.ClientIp!)
            .Distinct()
            .ToListAsync();

        if (userIps.Any())
        {
            var bannedUserIps = await db.BannedIps.AsNoTracking()
                .Where(b => userIps.Contains(b.IpAddress))
                .ToListAsync();

            var threatScores = await db.IpThreatScores.AsNoTracking()
                .Where(t => userIps.Contains(t.IpAddress))
                .ToListAsync();

            if (bannedUserIps.Any())
            {
                sb.AppendLine("## ⚠️ IPs bannies associées à cet utilisateur");
                foreach (var ban in bannedUserIps)
                    sb.AppendLine($"- {ban.IpAddress} : banni le {TZ.ToLocal(ban.BannedAt):dd/MM/yyyy}, {ban.BanCount}x ban(s), motif: {ban.Reason}, actif: {(ban.IsActive ? "OUI" : "non")}");
                sb.AppendLine();
            }

            var highThreat = threatScores.Where(t => t.Score >= 50).ToList();
            if (highThreat.Any())
            {
                sb.AppendLine("## ⚠️ Threat scores élevés (IPs de cet utilisateur)");
                foreach (var ts in highThreat.OrderByDescending(t => t.Score))
                    sb.AppendLine($"- {ts.IpAddress} : score {ts.Score} (zone {(ts.Score >= 200 ? "BAN" : ts.Score >= 100 ? "QUARANTAINE" : "ALERTE")})");
                sb.AppendLine();
            }
        }

        // Détection automatique de fraude / contournement
        var securityFlags = new List<string>();
        if (!license!.IsActive)
        {
            var activationAttemptsAfterRevoke = topEvents.FirstOrDefault(e =>
                e.Name != null && e.Name.Contains("LicenseActivated"))?.Count ?? 0;
            if (activationAttemptsAfterRevoke > 0)
                securityFlags.Add($"CONTOURNEMENT PROBABLE : licence révoquée/inactive avec {activationAttemptsAfterRevoke} tentative(s) d'activation réussie détectée(s)");
            var revokedHistory = licenseHistory.Where(h => h.Action == "REVOKED" || h.Action == "BANNED").ToList();
            if (revokedHistory.Any())
                securityFlags.Add($"Licence révoquée délibérément : {string.Join(" / ", revokedHistory.Select(h => $"{h.Action} le {TZ.ToLocal(h.Timestamp):dd/MM/yyyy} ({h.Details ?? "sans motif"})"))}");
        }
        if (propSummary.TryGetValue("IsVM", out var vmVals) && vmVals.Any(v => v.Equals("True", StringComparison.OrdinalIgnoreCase)))
        {
            if (propSummary.TryGetValue("VMPlatform", out var vmPlatVals))
                securityFlags.Add($"Machine virtuelle détectée ({string.Join(", ", vmPlatVals.Distinct().Take(2))}) — contexte compatible reverse engineering");
            else
                securityFlags.Add("Machine virtuelle détectée — contexte compatible reverse engineering");
        }
        if (license.CustomerEmail != null && (license.CustomerEmail.Contains("privaterelay.appleid.com") || license.CustomerEmail.Contains("relay.firefox.com")))
            securityFlags.Add($"Email de relais anonymisé ({license.CustomerEmail}) — identité volontairement masquée");

        if (securityFlags.Any())
        {
            sb.AppendLine("## 🚨 SIGNAUX DE SÉCURITÉ CRITIQUES");
            foreach (var flag in securityFlags) sb.AppendLine($"- {flag}");
            sb.AppendLine();
        }

        sb.AppendLine("---");
        sb.AppendLine("RÈGLES D'ANALYSE ABSOLUES — à respecter impérativement :");
        sb.AppendLine("- Si la licence est marquée RÉVOQUÉE/INACTIVE et que des tentatives d'activation sont présentes dans les événements → c'est une FRAUDE CONFIRMÉE ou une tentative de contournement. NE PAS diagnostiquer comme 'problème technique'. NE PAS recommander d'aide support.");
        sb.AppendLine("- Si des IPs bannies ou des threat scores élevés sont présents → traiter comme un profil hostile, pas comme un utilisateur légitime en difficulté.");
        sb.AppendLine("- Si une VM est détectée combinée à une licence révoquée → indiquer explicitement le risque de reverse engineering / piratage.");
        sb.AppendLine("- Si l'email est un relais anonyme (privaterelay.appleid.com, relay.firefox.com) → signaler comme élément de dissimulation d'identité.");
        sb.AppendLine();
        sb.AppendLine("Fournis une analyse structurée avec ces 7 sections :");
        sb.AppendLine("1. **Évaluation sécurité** : catégorise le profil — Utilisateur légitime / Suspect / Fraudeur confirmé / Attaquant. Justifie avec les signaux de sécurité (historique licence, bans IP, threat scores, VM, email anonyme, tentatives post-révocation).");
        sb.AppendLine("2. **Classification du profil** (uniquement si utilisateur légitime) : intégrateur technique, développeur API, agent MCP/automatisé, utilisateur final, testeur.");
        sb.AppendLine("3. **Potentiel commercial** (uniquement si utilisateur légitime) : score Faible/Moyen/Élevé/Très élevé avec signaux positifs et négatifs.");
        sb.AppendLine("4. **Résumé comportemental** : profil d'utilisation réel — usage normal, exploitation de faille, contournement de licence, reconnaissance du système.");
        sb.AppendLine("5. **Points d'attention** : erreurs, anomalies, risques de churn (si légitime) ou signaux d'attaque (si fraudeur).");
        sb.AppendLine("6. **Santé technique** : OS, compatibilité, versions, diagnostics, risques de blocage (si légitime) ou environnement d'attaque (VM, droits, outils).");
        sb.AppendLine("7. **Actions recommandées** : actions priorisées — si fraudeur : renforcement sécurité, blocage, analyse forensique. Si légitime : support, upsell, renouvellement.");

        return sb.ToString();
    }

    /// <summary>Convertit le Markdown basique de la réponse Claude en HTML léger.</summary>
    private static string FormatAiReport(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        var sb = new StringBuilder();
        foreach (var line in text.Split('\n'))
        {
            var l = System.Web.HttpUtility.HtmlEncode(line.TrimEnd());

            if (l.StartsWith("## "))
                sb.AppendLine($"<h2>{l[3..]}</h2>");
            else if (l.StartsWith("### "))
                sb.AppendLine($"<h3>{l[4..]}</h3>");
            else if (l.StartsWith("- ") || l.StartsWith("* "))
                sb.AppendLine($"<li>{ApplyInline(l[2..])}</li>");
            else if (l == "---")
                sb.AppendLine("<hr/>");
            else if (string.IsNullOrWhiteSpace(l))
                sb.AppendLine("<br/>");
            else
                sb.AppendLine($"<p>{ApplyInline(l)}</p>");
        }

        // Wrap consecutive <li> in <ul>
        var result = System.Text.RegularExpressions.Regex.Replace(
            sb.ToString(),
            @"(<li>.*?</li>\s*)+",
            m => $"<ul>{m.Value}</ul>",
            System.Text.RegularExpressions.RegexOptions.Singleline);

        return result;
    }

    private static string ApplyInline(string s)
    {
        // **bold**
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        // `code`
        s = System.Text.RegularExpressions.Regex.Replace(s, @"`(.+?)`", "<code>$1</code>");
        return s;
    }
