    private async Task LoadSecuritySection()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // Canary alerts for all HWIDs of this user
        secCanaryAlerts = await db.CanaryAlerts.AsNoTracking()
            .Where(c => hardwareIds.Contains(c.HardwareId))
            .OrderByDescending(c => c.ReceivedAt)
            .Take(50)
            .ToListAsync();

        // HWID bans
        secHwidBans = await db.BannedHardwareIds.AsNoTracking()
            .Where(b => hardwareIds.Contains(b.HardwareId))
            .OrderByDescending(b => b.BannedAt)
            .ToListAsync();

        // Component bans — match via HardwareFingerprint hashes
        var fp = await db.HardwareFingerprints.AsNoTracking()
            .Where(f => hardwareIds.Contains(f.HardwareId))
            .ToListAsync();

        var componentHashes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var matchedTypesByHash = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in fp)
        {
            AddComponentHash(componentHashes, matchedTypesByHash, f.CpuHash, "CPU");
            AddComponentHash(componentHashes, matchedTypesByHash, f.MotherboardHash, "MB");
            AddComponentHash(componentHashes, matchedTypesByHash, f.BiosHash, "BIOS");
            AddComponentHash(componentHashes, matchedTypesByHash, f.DiskHash, "DISK");
            AddComponentHash(componentHashes, matchedTypesByHash, f.HostHash, "HOST");
        }

        if (componentHashes.Count > 0)
        {
            var componentBans = await db.BannedComponents.AsNoTracking()
                .Where(b => componentHashes.Contains(b.ComponentHash))
                .OrderByDescending(b => b.BannedAt)
                .ToListAsync();

            secComponentBans = componentBans
                .Select(b => ComponentBanView.From(b, matchedTypesByHash.TryGetValue(b.ComponentHash, out var types) ? types : new()))
                .ToList();
        }
        else
        {
            secComponentBans = new();
        }

        // Related HWIDs via clustering
        secRelatedHwids = new();
        foreach (var hwid in hardwareIds)
        {
            var related = await FingerprintSvc.FindRelatedHwidsAsync(hwid);
            foreach (var r in related.Where(r => !hardwareIds.Contains(r.HardwareId)))
            {
                if (!secRelatedHwids.Any(x => x.HardwareId == r.HardwareId))
                    secRelatedHwids.Add(r);
            }
        }

        // License cross-ref for related HWIDs
        var relHwids = secRelatedHwids.Select(r => r.HardwareId).ToList();
        if (relHwids.Count > 0)
        {
            var relSeats = await db.LicenseSeats.AsNoTracking()
                .Where(s => relHwids.Contains(s.HardwareId) && s.IsActive)
                .Select(s => new { s.HardwareId, s.LicenseId })
                .ToListAsync();
            secRelatedLicenses = relSeats.GroupBy(s => s.HardwareId)
                .ToDictionary(g => g.Key, g => g.First().LicenseId);
        }

        secBanCount = secHwidBans.Count(b => b.IsActive) + secComponentBans.Count(b => b.IsActive && !b.IsWeakCorrelation);
        secCanaryCount = secCanaryAlerts.Count;
        secLoaded = true;
    }

    private static void AddComponentHash(
        HashSet<string> hashes,
        Dictionary<string, HashSet<string>> matchedTypesByHash,
        string? hash,
        string componentType)
    {
        if (string.IsNullOrWhiteSpace(hash))
            return;

        hashes.Add(hash);
        if (!matchedTypesByHash.TryGetValue(hash, out var types))
        {
            types = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            matchedTypesByHash[hash] = types;
        }

        types.Add(componentType);
    }

