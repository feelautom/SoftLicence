@page "/user-telemetry/{LicenseId:guid}"
@inject IDbContextFactory<LicenseDbContext> DbFactory
@inject SoftLicence.Server.Services.AuthService Auth
@inject SoftLicence.Server.Services.TimeZoneService TZ
@inject SoftLicence.Server.Services.ToastService Toast
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject SoftLicence.Server.Services.FingerprintService FingerprintSvc
@inject SoftLicence.Server.Services.AiAnalysisService AiAnalysis
@inject IJSRuntime JS
@using SoftLicence.Server.Data
@using SoftLicence.Server.Services
@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Text.Json

<div class="container-fluid animate-fade">
    @if (!isAuthorized)
    {
        <div class="text-center py-5">
            <h2 class="text-white">@L["Common_AccessDenied"]</h2>
            <p class="text-muted">@L["Common_NoPermission"]</p>
        </div>
    }
    else if (license == null)
    {
        <div class="text-center py-5">
            <h2 class="text-muted">@L["Common_Loading"]</h2>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="GoBack" title="@L["Common_Back"]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/></svg>
                </button>
                <div>
                    <h3 class="mb-0">@L["UserTelemetry_Title"]</h3>
                    <small class="text-muted">@license.CustomerName — @(license.Product?.Name ?? "?")</small>
                </div>
            </div>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width: 130px;" @bind:get="FilterType" @bind:set="async (v) => { FilterType = v; CurrentPage = 1; await Refresh(); }">
                    <option value="">@L["Telemetry_AllTypes"]</option>
                    <option value="Event">@L["Telemetry_Events"]</option>
                    <option value="Diagnostic">@L["Telemetry_Diagnostics"]</option>
                    <option value="Error">@L["Telemetry_Errors"]</option>
                </select>
                <button class="btn btn-primary btn-sm" @onclick="Refresh">@L["Common_Refresh"]</button>
                <button class="btn btn-outline-warning btn-sm" @onclick="AnalyzeWithAi" disabled="@aiLoading" title="Analyse comportementale par IA">
                    @if (aiLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="me-1" viewBox="0 0 24 24"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                    }
                    Analyser avec l'IA
                </button>
            </div>
        </div>

        <!-- License summary card -->
        <div class="card bg-dark border-secondary mb-4">
            <div class="card-body py-3">
                <div class="row">
                    <div class="col-md-3">
                        <small class="text-muted d-block">@L["Licenses_Client"]</small>
                        <span class="fw-bold">@license.CustomerName</span>
                        <div class="small text-muted">@license.CustomerEmail</div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["Licenses_Software"]</small>
                        <span class="fw-bold">@(license.Product?.Name ?? "-")</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">@L["Licenses_Key"]</small>
                        <div class="d-flex align-items-center gap-2">
                            <code class="small text-muted">@MaskedSecret()</code>
                            <button class="btn btn-link text-info p-0" style="line-height:1" title="Copier la clé" aria-label="Copier la clé" @onclick="() => CopyToClipboard(license.LicenseKey)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M4 2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H6z"/>
                                    <path d="M2 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h1v1H2z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["Licenses_Seats"]</small>
                        <span>@hardwareIds.Count @L["UserTelemetry_Devices"]</span>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["UserTelemetry_TotalRecords"]</small>
                        <span class="fw-bold text-info">@TotalCount</span>
                    </div>
                </div>
                <hr class="my-2 border-secondary" />
                <div class="row">
                    @{
                        var isActivated = !string.IsNullOrEmpty(license.HardwareId) || (license.Seats?.Any(s => s.IsActive) ?? false);
                        var isExpired = license.ExpirationDate.HasValue && DateTime.UtcNow >= license.ExpirationDate.Value;
                    }
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["UserTelemetry_Status"]</small>
                        @if (!license.IsActive)
                        {
                            <span class="badge bg-danger">@L["UserTelemetry_Inactive"]</span>
                        }
                        else if (!isActivated)
                        {
                            <span class="badge bg-secondary">@L["Common_Issued"]</span>
                        }
                        else if (isExpired)
                        {
                            <span class="badge bg-warning text-dark">@L["UserTelemetry_Expired"]</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@L["UserTelemetry_Active"]</span>
                        }
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["UserTelemetry_LicenseType"]</small>
                        <span class="badge bg-info text-dark">@(license.Type?.Slug ?? "-")</span>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["UserTelemetry_ActivationDate"]</small>
                        <span>@(license.ActivationDate.HasValue ? TZ.ToLocal(license.ActivationDate.Value).ToString("dd/MM/yyyy") : L["UserTelemetry_NotActivated"])</span>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["UserTelemetry_Expiration"]</small>
                        @if (license.ExpirationDate.HasValue)
                        {
                            <span>@TZ.ToLocal(license.ExpirationDate.Value).ToString("dd/MM/yyyy")</span>
                        }
                        else
                        {
                            <span class="text-success">@L["UserTelemetry_Lifetime"]</span>
                        }
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["UserTelemetry_DaysRemaining"]</small>
                        @if (license.ExpirationDate.HasValue)
                        {
                            var remaining = license.ExpirationDate.Value - DateTime.UtcNow;
                            var daysLeft = (int)remaining.TotalDays;
                            var hoursLeft = remaining.Hours;
                            <span class="fw-bold @(daysLeft < 0 ? "text-danger" : daysLeft <= 30 ? "text-warning" : "text-success")">
                                @if (remaining.TotalSeconds <= 0)
                                {
                                    @L["UserTelemetry_Expired"]
                                }
                                else
                                {
                                    @($"{daysLeft} j. {hoursLeft}h")
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-success">∞</span>
                        }
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted d-block">@L["UserTelemetry_MaxSeats"]</small>
                        <span>@license.MaxSeats</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(license.Reference))
                {
                    <div class="row mt-2">
                        <div class="col-md-2">
                            <small class="text-muted d-block">@L["UserTelemetry_Reference"]</small>
                            <span class="small">@license.Reference</span>
                        </div>
                        <div class="col-md-2">
                            <small class="text-muted d-block">@L["UserTelemetry_CreationDate"]</small>
                            <span>@TZ.ToLocal(license.CreationDate).ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Cluster info -->
        @if (clusterInfo != null)
        {
            var otherMembers = clusterInfo.Members
                .Where(m => !hardwareIds.Contains(m.HardwareId))
                .ToList();
            @if (otherMembers.Any())
            {
                <div class="card bg-dark border-warning mb-4">
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-warning text-dark">Cluster</span>
                            <small class="fw-bold">@(clusterInfo.Label ?? clusterInfo.ClusterId.ToString()[..8])</small>
                            <small class="text-muted">@clusterInfo.Members.Count HWIDs | @clusterInfo.CommonComponents/5 composants communs</small>
                            <a href="/fingerprints" class="btn btn-sm btn-outline-secondary ms-auto py-0" style="font-size:0.7rem">Voir le cluster</a>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var m in otherMembers)
                            {
                                var firstLic = m.Licenses.FirstOrDefault(l => l.LicenseId != Guid.Empty);
                                <div class="border border-secondary rounded px-2 py-1" style="font-size:0.8rem">
                                    @if (firstLic != null)
                                    {
                                        <a href="/user-telemetry/@firstLic.LicenseId" class="text-info text-decoration-none font-monospace">@m.HardwareId[..Math.Min(12, m.HardwareId.Length)]...</a>
                                        <span class="text-muted ms-1">@firstLic.CustomerName</span>
                                        <span class="badge bg-@(firstLic.IsActive ? "success" : "secondary") ms-1" style="font-size:0.6rem">@firstLic.TypeName</span>
                                    }
                                    else
                                    {
                                        <span class="font-monospace text-muted">@m.HardwareId[..Math.Min(12, m.HardwareId.Length)]...</span>
                                        <small class="text-muted ms-1">No license</small>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <!-- KPI cards -->
        @if (TotalCount > 0)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-2">
                    <div class="card bg-dark border-primary text-center py-2">
                        <div class="small text-muted">Activité réelle</div>
                        <div class="fs-4 fw-bold text-primary">@eventCount</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card bg-dark border-success text-center py-2">
                        <div class="small text-muted">@L["Telemetry_Diagnostics"]</div>
                        <div class="fs-4 fw-bold text-success">@diagnosticCount</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card bg-dark border-danger text-center py-2">
                        <div class="small text-muted">@L["Telemetry_Errors"]</div>
                        <div class="fs-4 fw-bold text-danger">@errorCount</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card bg-dark border-secondary text-center py-2">
                        <div class="small text-muted">Bruit système</div>
                        <div class="fs-4 fw-bold text-secondary">@systemNoiseEventCount</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-dark border-info text-center py-2">
                        <div class="small text-muted">@L["UserTelemetry_Activity"]</div>
                        <div class="small"><span class="text-muted">@L["UserTelemetry_FirstActivity"]</span> <span class="fw-bold text-info">@(firstActivity.HasValue ? TZ.ToLocal(firstActivity.Value).ToString("dd/MM/yyyy HH:mm") : "-")</span></div>
                        <div class="small"><span class="text-muted">@L["UserTelemetry_LastActivity"]</span> <span class="fw-bold text-info">@(lastActivity.HasValue ? TZ.ToLocal(lastActivity.Value).ToString("dd/MM/yyyy HH:mm") : "-")</span></div>
                    </div>
                </div>
            </div>
        }

        <!-- Quota charts (Freemium / School) -->
        @if (quotaData.Any())
        {
            <div class="card bg-dark border-secondary mb-4">
                <div class="card-body py-3">
                    <h6 class="text-info mb-3">Quotas — 7 derniers jours</h6>
                    <div class="row g-3">
                        @foreach (var quotaType in quotaData.Keys.OrderBy(k => k))
                        {
                            var data = quotaData[quotaType];
                            var quotaMaxUsed = data.Max(d => d.MaxUsed);
                            var quotaLimit = data.FirstOrDefault()?.Limit ?? 0;
                            var quotaHasUsage = quotaMaxUsed > 0;
                            var quotaPeakPct = quotaLimit > 0 ? quotaMaxUsed * 100.0 / quotaLimit : 0;
                            var quotaAccent = quotaPeakPct >= 90 ? "#ff4d5e" : quotaPeakPct >= 50 ? "#ffc107" : quotaHasUsage ? "#20c997" : "#6c757d";
                            <div class="col-md-4">
                                <div class="border rounded p-2" style="border-color: @quotaAccent !important; box-shadow: @(quotaHasUsage ? $"0 0 0 1px {quotaAccent}33" : "none");">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold" style="font-size: 0.95rem;">@quotaType</span>
                                        <span class="fw-bold" style="font-size: 0.95rem; color: @quotaAccent;">Max: @quotaMaxUsed/@quotaLimit</span>
                                    </div>
                                    <div class="chart-container d-flex align-items-end justify-content-around" style="height: 96px;">
                                        @foreach (var day in data)
                                        {
                                            var pct = day.Limit > 0 ? (int)Math.Round(day.MaxUsed * 100.0 / day.Limit) : 0;
                                            pct = Math.Clamp(pct, 0, 100);
                                            var hasDayUsage = day.MaxUsed > 0;
                                            var color = day.MaxUsed >= day.Limit * 0.9 ? "#ff4d5e" : day.MaxUsed >= day.Limit * 0.5 ? "#ffc107" : hasDayUsage ? "#20c997" : "#0dcaf0";
                                            <div class="d-flex flex-column align-items-center" style="flex: 1; min-width: 0;">
                                                <small class="fw-bold @(hasDayUsage ? "" : "text-muted")" style="font-size: @(hasDayUsage ? "0.8rem" : "0.6rem"); color: @(hasDayUsage ? color : "");">@day.MaxUsed</small>
                                                <div class="d-flex align-items-end justify-content-center" style="height: 58px; width: 100%;">
                                                    <div style="width: 60%; height: @(hasDayUsage ? Math.Max(pct, 8) : 3)%; background: @color; border-radius: 3px 3px 0 0; min-height: 2px;" title="@day.Date.ToString("dd/MM") — @day.MaxUsed/@day.Limit (@pct%)"></div>
                                                </div>
                                                <small class="@(hasDayUsage ? "fw-bold" : "text-muted")" style="font-size: @(hasDayUsage ? "0.65rem" : "0.55rem"); color: @(hasDayUsage ? color : "");">@day.Date.ToString("dd/MM")</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Daily usage chart (Paid licenses) -->
        @if (dailyUsage.Any())
        {
            var maxCount = dailyUsage.Max(d => d.Count);
            if (maxCount == 0) maxCount = 1;
            var totalEvents = dailyUsage.Sum(d => d.Count);
            var activeDays = dailyUsage.Count(d => d.Count > 0);
            var chartH = 150;
            var barW = 100.0 / dailyUsage.Count;
            <div class="card bg-dark border-secondary mb-4">
                <div class="card-body py-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <h6 class="text-success mb-0">Activité réelle — @DailyUsageWindowDays jours</h6>
                            <span class="small text-muted">@DailyUsageWindowStart.ToString("dd/MM/yyyy") - @DailyUsageWindowEnd.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted">@totalEvents événements utiles · @activeDays jours actifs · moy. @(activeDays > 0 ? totalEvents / activeDays : 0)/jour</span>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Navigation période activité réelle">
                                <button class="btn btn-outline-secondary" title="30 jours précédents" disabled="@(!CanGoPreviousDailyUsageWindow)" @onclick="PreviousDailyUsageWindow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/></svg>
                                </button>
                                <button class="btn btn-outline-secondary" title="30 jours suivants" disabled="@(!CanGoNextDailyUsageWindow)" @onclick="NextDailyUsageWindow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                    <svg width="100%" height="@(chartH + 20)" viewBox="0 0 1000 @(chartH + 20)" preserveAspectRatio="none">
                        @for (var i = 0; i < dailyUsage.Count; i++)
                        {
                            var day = dailyUsage[i];
                            var barH = day.Count > 0 ? (int)(day.Count * (chartH - 20.0) / maxCount) + 4 : 0;
                            var x = (int)(i * 1000.0 / dailyUsage.Count);
                            var w = (int)(1000.0 / dailyUsage.Count) - 3;
                            var y = chartH - barH;
                            var color = day.Count == 0 ? "#2a2a3a" : day.Count >= maxCount * 0.8 ? "#198754" : day.Count >= maxCount * 0.4 ? "#0dcaf0" : "#6c757d";
                            <rect x="@x" y="@y" width="@w" height="@barH" rx="2" fill="@color">
                                <title>@day.Date.ToString("dd/MM/yyyy") — @day.Count événements utiles</title>
                            </rect>
                            @if (day.Count > 0)
                            {
                                @((MarkupString)$"<text x=\"{x + w / 2}\" y=\"{y - 3}\" text-anchor=\"middle\" fill=\"#aaa\" font-size=\"9\">{day.Count}</text>")
                            }
                            @((MarkupString)$"<text x=\"{x + w / 2}\" y=\"{chartH + 14}\" text-anchor=\"middle\" fill=\"#666\" font-size=\"8\">{day.Date:dd/MM}</text>")
                        }
                    </svg>
                </div>
            </div>
        }

        @* ── Section Sécurité ── *@
        <div class="card bg-dark border-secondary mt-4">
            <div class="card-header d-flex justify-content-between align-items-center py-2" style="cursor:pointer" @onclick="ToggleSecuritySection">
                <span class="fw-semibold d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    Sécurité
                    @if (secBanCount > 0)
                    {
                        <span class="badge bg-danger ms-1" style="font-size:0.65rem">@secBanCount ban(s)</span>
                    }
                    @if (secCanaryCount > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem">@secCanaryCount alerte(s)</span>
                    }
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    @if (showSecuritySection) {
                        <polyline points="18 15 12 9 6 15"/>
                    } else {
                        <polyline points="6 9 12 15 18 9"/>
                    }
                </svg>
            </div>

            @if (showSecuritySection)
            {
                @if (!secLoaded)
                {
                    <div class="card-body text-center py-3 text-muted">
                        <div class="spinner-border spinner-border-sm me-2"></div>Chargement...
                    </div>
                }
                else
                {
                    <div class="card-body p-3">

                        @* HWIDs liés *@
                        @if (secRelatedHwids.Count > 0)
                        {
                            <div class="mb-3">
                                <h6 class="text-muted small text-uppercase mb-2">HWIDs liés (cluster)</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var rel in secRelatedHwids)
                                    {
                                        <div class="card bg-dark border-warning p-2" style="min-width:200px">
                                            <code class="text-warning small">@(rel.HardwareId.Length > 14 ? rel.HardwareId[..14] + "…" : rel.HardwareId)</code>
                                            <small class="text-muted">@rel.MatchCount/5 composants communs</small>
                                            @if (secRelatedLicenses.TryGetValue(rel.HardwareId, out var relLicId))
                                            {
                                                <a href="/user-telemetry/@relLicId" class="text-info small">Voir fiche</a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* Canary Alerts *@
                        @if (secCanaryAlerts.Count > 0)
                        {
                            <div class="mb-3">
                                <h6 class="text-muted small text-uppercase mb-2">Canary Alerts (@secCanaryAlerts.Count)</h6>
                                <div class="table-responsive">
                                    <table class="table table-dark table-sm align-middle mb-0">
                                        <thead>
                                            <tr class="text-muted" style="font-size:0.75rem">
                                                <th>Date</th>
                                                <th>Trigger</th>
                                                <th>Sévérité</th>
                                                <th>IP</th>
                                                <th>Détails</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in secCanaryAlerts)
                                            {
                                                <tr>
                                                    <td class="text-muted small text-nowrap">@TZ.ToLocal(DateTime.SpecifyKind(c.ReceivedAt, DateTimeKind.Utc)).ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td><code class="text-warning small">@c.Trigger</code></td>
                                                    <td>
                                                        @{
                                                            var sevBadge = c.Severity switch { 3 => ("danger","CRITIQUE"), 2 => ("warning","WARNING"), _ => ("secondary","INFO") };
                                                        }
                                                        <span class="badge bg-@sevBadge.Item1" style="font-size:0.6rem">@sevBadge.Item2</span>
                                                    </td>
                                                    <td class="small text-muted">@(c.ClientIp ?? "—")</td>
                                                    <td class="small text-muted" style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="@c.Details">@(c.Details ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        @* HWID Bans *@
                        @if (secHwidBans.Count > 0)
                        {
                            <div class="mb-3">
                                <h6 class="text-muted small text-uppercase mb-2">Bans HWID (@secHwidBans.Count)</h6>
                                <div class="table-responsive">
                                    <table class="table table-dark table-sm align-middle mb-0">
                                        <thead>
                                            <tr class="text-muted" style="font-size:0.75rem">
                                                <th>Date</th>
                                                <th>HWID</th>
                                                <th>Catégorie</th>
                                                <th>Statut</th>
                                                <th>Motif</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var b in secHwidBans)
                                            {
                                                <tr>
                                                    <td class="text-muted small text-nowrap">@TZ.ToLocal(DateTime.SpecifyKind(b.BannedAt, DateTimeKind.Utc)).ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td><code class="text-info small">@(b.HardwareId.Length > 14 ? b.HardwareId[..14] + "…" : b.HardwareId)</code></td>
                                                    <td><span class="badge bg-danger" style="font-size:0.6rem">@(b.BanCategory ?? "manual")</span></td>
                                                    <td>@(b.IsActive ? @<span class="badge bg-danger" style="font-size:0.6rem">ACTIF</span> : @<span class="badge bg-secondary" style="font-size:0.6rem">LEVÉ</span>)</td>
                                                    <td class="small text-muted" style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="@b.Reason">@b.Reason</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        @* Component Bans *@
                        @if (secComponentBans.Count > 0)
                        {
                            <div class="mb-3">
                                <h6 class="text-muted small text-uppercase mb-2">Bans Composants / Corrélations (@secComponentBans.Count)</h6>
                                <div class="table-responsive">
                                    <table class="table table-dark table-sm align-middle mb-0">
                                        <thead>
                                            <tr class="text-muted" style="font-size:0.75rem">
                                                <th>Date</th>
                                                <th>Type</th>
                                                <th>Confiance</th>
                                                <th>Hash</th>
                                                <th>Statut</th>
                                                <th>Motif</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var b in secComponentBans)
                                            {
                                                <tr class="@(b.IsWeakCorrelation ? "table-warning" : "")">
                                                    <td class="text-muted small text-nowrap">@TZ.ToLocal(DateTime.SpecifyKind(b.BannedAt, DateTimeKind.Utc)).ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>
                                                        <span class="badge bg-warning text-dark" style="font-size:0.6rem">@b.ComponentType</span>
                                                        <div class="text-muted" style="font-size:0.65rem">@b.MatchSummary</div>
                                                    </td>
                                                    <td><span class="badge bg-@GetComponentConfidenceBadge(b.MatchStrength)" style="font-size:0.6rem">@GetComponentConfidenceLabel(b.MatchStrength)</span></td>
                                                    <td><code class="text-muted small">@(b.ComponentHash.Length > 12 ? b.ComponentHash[..12] + "…" : b.ComponentHash)</code></td>
                                                    <td>
                                                        @if (b.IsActive && !b.IsWeakCorrelation)
                                                        {
                                                            <span class="badge bg-danger" style="font-size:0.6rem">ACTIF</span>
                                                        }
                                                        else if (b.IsActive)
                                                        {
                                                            <span class="badge bg-warning text-dark" style="font-size:0.6rem">HISTORIQUE FAIBLE</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary" style="font-size:0.6rem">LEVÉ</span>
                                                        }
                                                    </td>
                                                    <td class="small text-muted" style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="@b.Reason">@b.Reason</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        @if (secCanaryAlerts.Count == 0 && secHwidBans.Count == 0 && secComponentBans.Count == 0 && secRelatedHwids.Count == 0)
                        {
                            <p class="text-muted small mb-0 text-center py-2">Aucun événement de sécurité pour cet utilisateur.</p>
                        }
                    </div>
                }
            }
        </div>


        <!-- Hardware IDs list -->
        @if (hardwareIds.Count > 1)
        {
            <div class="mb-3">
                <small class="text-muted me-2">@L["UserTelemetry_FilterDevice"]</small>
                <button class="btn btn-sm @(FilterHardwareId == null ? "btn-outline-info active" : "btn-outline-secondary") me-1" @onclick="async () => { FilterHardwareId = null; CurrentPage = 1; await Refresh(); }">
                    @L["Common_All"]
                </button>
                @foreach (var hwId in hardwareIds)
                {
                    <button class="btn btn-sm @(FilterHardwareId == hwId ? "btn-outline-info active" : "btn-outline-secondary") me-1"
                            @onclick="async () => { FilterHardwareId = hwId; CurrentPage = 1; await Refresh(); }">
                        <code class="small">@hwId[..Math.Min(12, hwId.Length)]...</code>
                    </button>
                }
            </div>
        }

        <!-- Telemetry table -->
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle" style="font-size: 0.85rem;">
                <thead>
                    <tr>
                        <th>@L["Common_DateLocal"]</th>
                        <th>@L["Common_Type"]</th>
                        <th>@L["Telemetry_Event"]</th>
                        <th>Version</th>
                        <th>@L["Telemetry_HardwareId"]</th>
                        <th>IP / ISP</th>
                        <th class="text-center">@L["Telemetry_EventData"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rec in Records)
                    {
                        var isExpanded = ExpandedRecordId == rec.Id;
                        <tr style="cursor: pointer" class="@(isExpanded ? "table-active" : "")" @onclick="() => ToggleRecord(rec.Id)">
                            <td class="text-nowrap">@TZ.ToLocal(rec.Timestamp).ToString("dd/MM HH:mm:ss")</td>
                            <td><span class="badge @GetTypeBadgeClass(rec.Type)">@rec.Type</span></td>
                            <td>@rec.EventName</td>
                            <td><small class="text-muted">@rec.Version</small></td>
                            <td><code class="small">@rec.HardwareId</code></td>
                            <td class="text-nowrap" title="IP: @rec.ClientIp | ISP: @(rec.Isp ?? "Unknown")">
                                @if (!string.IsNullOrEmpty(rec.ClientIp))
                                {
                                    <code class="small">@rec.ClientIp</code>
                                    @if (!string.IsNullOrEmpty(rec.Isp))
                                    {
                                        <div class="text-muted" style="font-size: 0.65rem; max-width: 120px; overflow: hidden; text-overflow: ellipsis;">@rec.Isp</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="text-muted small">@(isExpanded ? "▲" : "▼")</span>
                            </td>
                        </tr>
                        @if (isExpanded)
                        {
                            <tr class="bg-dark bg-opacity-25 animate-fade">
                                <td colspan="7" class="p-0 border-start border-4 border-info">
                                    <div class="p-3">
                                        @if (rec.Type == TelemetryType.Event && rec.EventData != null)
                                        {
                                            var props = ParseJsonProperties(rec.EventData.PropertiesJson);
                                            if (props.Any())
                                            {
                                                <table class="table table-sm table-dark mb-0" style="font-size: 0.8rem;">
                                                    <thead><tr><th style="width: 200px">@L["UserTelemetry_Property"]</th><th>@L["UserTelemetry_Value"]</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var kv in props)
                                                        {
                                                            var isSensitive = IsSensitiveTelemetryField(kv.Key, kv.Value);
                                                            <tr>
                                                                <td class="text-info fw-bold">@kv.Key</td>
                                                                <td class="text-light">
                                                                    @if (isSensitive)
                                                                    {
                                                                        <div class="d-flex align-items-center gap-2">
                                                                            <code class="small text-muted">@MaskedSecret()</code>
                                                                            <button class="btn btn-link text-info p-0" style="line-height:1" title="Copier la valeur" aria-label="Copier la valeur" @onclick="() => CopyToClipboard(kv.Value)">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                                                                    <path d="M4 2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H6z"/>
                                                                                    <path d="M2 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h1v1H2z"/>
                                                                                </svg>
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        @kv.Value
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic">@L["Telemetry_NoExtraData"]</span>
                                            }
                                        }
                                        else if (rec.Type == TelemetryType.Error && rec.ErrorData != null)
                                        {
                                            <table class="table table-sm table-dark mb-0" style="font-size: 0.8rem;">
                                                <tbody>
                                                    <tr>
                                                        <td class="text-info fw-bold" style="width: 200px">@L["UserTelemetry_ErrorType"]</td>
                                                        <td class="text-danger fw-bold">@rec.ErrorData.ErrorType</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="text-info fw-bold">Message</td>
                                                        <td class="text-light">@rec.ErrorData.Message</td>
                                                    </tr>
                                                    @if (!string.IsNullOrEmpty(rec.ErrorData.StackTrace))
                                                    {
                                                        <tr>
                                                            <td class="text-info fw-bold">Stack Trace</td>
                                                            <td><pre class="small text-muted mb-0" style="max-height: 200px; overflow-y: auto; white-space: pre-wrap;">@rec.ErrorData.StackTrace</pre></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else if (rec.Type == TelemetryType.Diagnostic && rec.DiagnosticData != null)
                                        {
                                            <div class="mb-2">@L["Telemetry_GlobalScore"] <span class="badge bg-info">@rec.DiagnosticData.Score / 100</span></div>
                                            <table class="table table-sm table-dark mb-0" style="font-size: 0.8rem;">
                                                <thead>
                                                    <tr>
                                                        <th>Module</th>
                                                        <th class="text-center" style="width: 80px">@L["Common_Status"]</th>
                                                        <th>Message</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var r in rec.DiagnosticData.Results)
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">@r.ModuleName</td>
                                                            <td class="text-center"><span class="badge @(r.Success ? "bg-success" : "bg-danger")">@(r.Success ? "OK" : "KO")</span></td>
                                                            <td class="text-light">@r.Message</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            @if (rec.DiagnosticData.Ports.Any())
                                            {
                                                <h6 class="mt-3 mb-1 small text-muted">@L["Telemetry_Ports"]</h6>
                                                <table class="table table-sm table-dark mb-0" style="font-size: 0.8rem;">
                                                    <thead><tr><th>@L["Common_Name"]</th><th>Port</th><th>Proto</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var p in rec.DiagnosticData.Ports)
                                                        {
                                                            <tr><td>@p.Name</td><td>@p.ExternalPort</td><td>@p.Protocol</td></tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">@L["Telemetry_NoExtraData"]</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    @if (!Records.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">@L["UserTelemetry_NoRecords"]</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (TotalCount > 0)
        {
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">@L["Common_Show"]</small>
                    <select class="form-select form-select-sm" style="width: 80px;" @bind:get="PageSize" @bind:set="ChangePageSize">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <small class="text-muted">@L["Common_Of"] @TotalCount @L["Common_Entries"]</small>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">@L["Common_Previous"]</button>
                        </li>
                        <li class="page-item disabled"><span class="page-link">@L["Common_Page"] @CurrentPage / @TotalPages</span></li>
                        <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">@L["Common_Next"]</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }

    }
</div>

@* ── Modal Analyse IA ── *@
@if (showAiModal && aiReport != null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.8);" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark border-warning">
                <div class="modal-header border-warning py-2">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="#ffc107" stroke-width="2" viewBox="0 0 24 24"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
