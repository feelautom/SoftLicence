    private async Task LoadData()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            Products = await db.Products.ToListAsync();
            LicenseTypes = await db.LicenseTypes.Include(t => t.Product).OrderBy(t => t.Product!.Name).ThenBy(t => t.Name).ToListAsync();

            // Stats globales (non filtrées)
            statTotal = await db.Licenses.CountAsync();
            statRevoked = await db.Licenses.CountAsync(l => !l.IsActive);
            statExpired = await db.Licenses.CountAsync(l => l.IsActive && l.ExpirationDate.HasValue && l.ExpirationDate <= DateTime.UtcNow);
            statIssued = await db.Licenses.CountAsync(l => l.IsActive
                && !l.Seats.Any(s => s.IsActive)
                && (l.Seats.Any() || l.HardwareId == null || l.HardwareId == ""));
            statActive = statTotal - statRevoked - statExpired - statIssued;

            bannedHwids = (await db.BannedHardwareIds
                .Where(b => b.IsActive && (b.ExpiresAt == null || b.ExpiresAt > DateTime.UtcNow))
                .Select(b => b.HardwareId)
                .ToListAsync())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            ExistingClients = (await db.Licenses
                .Where(l => l.CustomerName != "")
                .Select(l => new { l.CustomerName, l.CustomerEmail })
                .Distinct()
                .OrderBy(c => c.CustomerName)
                .ToListAsync())
                .Select(c => (c.CustomerName, c.CustomerEmail))
                .ToList();

            var query = db.Licenses.AsQueryable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var search = searchText.Trim().ToLower();
                query = query.Where(l => l.CustomerName.ToLower().Contains(search)
                    || l.CustomerEmail.ToLower().Contains(search)
                    || l.LicenseKey.ToLower().Contains(search)
                    || (l.HardwareId != null && l.HardwareId.ToLower().Contains(search))
                    || l.Seats.Any(s => s.HardwareId.ToLower().Contains(search))
                    || l.History.Any(h => h.PerformedBy != null && h.PerformedBy.ToLower().Contains(search)));
            }

            if (!string.IsNullOrEmpty(filterProduct))
                query = query.Where(l => l.ProductId.ToString() == filterProduct);

            if (!string.IsNullOrEmpty(filterType))
                query = query.Where(l => l.Type != null && l.Type.Slug == filterType);

            if (filterStatus == "active")
                query = query.Where(l => l.IsActive
                    && (l.Seats.Any(s => s.IsActive) || (!l.Seats.Any() && l.HardwareId != null))
                    && (!l.ExpirationDate.HasValue || l.ExpirationDate > DateTime.UtcNow));
            else if (filterStatus == "expired")
                query = query.Where(l => l.IsActive && l.ExpirationDate.HasValue && l.ExpirationDate <= DateTime.UtcNow);
            else if (filterStatus == "issued")
                query = query.Where(l => l.IsActive
                    && !l.Seats.Any(s => s.IsActive)
                    && (l.Seats.Any() || l.HardwareId == null || l.HardwareId == ""));
            else if (filterStatus == "revoked")
                query = query.Where(l => !l.IsActive);

            TotalCount = await query.CountAsync();

            if (CurrentPage > TotalPages && TotalPages > 0) CurrentPage = TotalPages;
            if (CurrentPage < 1) CurrentPage = 1;

            LicensesList = await query.Include(l => l.Product)
                                      .Include(l => l.Type)
                                          .ThenInclude(t => t!.CustomParams)
                                      .Include(l => l.Seats)
                                      .OrderByDescending(l => l.CreationDate)
                                      .Skip((CurrentPage - 1) * PageSize)
                                      .Take(PageSize)
                                      .ToListAsync();
        }
        catch (Exception ex) { Toast.ShowError($"{L["Common_Error"]} : {ex.Message}"); }
    }

    private async Task CreateLicense()
    {
        if (string.IsNullOrEmpty(SelectedProductId) || string.IsNullOrEmpty(SelectedTypeId) || (!isSelectedTypeAnonymous && string.IsNullOrEmpty(NewClientName)))
        {
            Toast.ShowError(L["Licenses_MsgMissingFields"]); return;
        }

        var key = Guid.NewGuid().ToString("D").ToUpper();
        var lic = new License
        {
            ProductId = Guid.Parse(SelectedProductId),
            LicenseTypeId = Guid.Parse(SelectedTypeId),
            CustomerName = isSelectedTypeAnonymous ? "Non attribué" : NewClientName,
            CustomerEmail = isSelectedTypeAnonymous ? "" : NewClientEmail,
            LicenseKey = key,
            IsActive = true,
            MaxSeats = newMaxSeats,
            ValidityDays = (newValidityDays.HasValue && newValidityDays.Value > 0) ? newValidityDays.Value : null
        };

        using var db = await DbFactory.CreateDbContextAsync();
        db.Licenses.Add(lic);

        var historyMsg = L["Licenses_Action_Created"].Value
            .Replace("{0}", LicenseTypes.First(t => t.Id == lic.LicenseTypeId).Name)
            .Replace("{1}", lic.MaxSeats.ToString());

        lic.History.Add(new LicenseHistory {
            Action = HistoryActions.Created,
            Details = historyMsg,
            PerformedBy = "Admin"
        });

        await db.SaveChangesAsync();
        GeneratedKey = key;
        
        if (!string.IsNullOrWhiteSpace(NewClientEmail))
        {
            try {
                var prod = Products.First(p => p.Id == lic.ProductId);
                await Mailer.SendLicenseEmailAsync(NewClientEmail, NewClientName, prod.Name, key);
                Toast.ShowSuccess(L["Licenses_MsgEmailSent"]);
            } catch { }
        }

        NewClientName = ""; NewClientEmail = ""; showCreate = false; newMaxSeats = 1;
        await LoadData();
    }

    private async Task Reactivate(License l)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var dbLic = await db.Licenses.FirstOrDefaultAsync(x => x.Id == l.Id);
        if (dbLic == null) { Toast.ShowError(L["Resets_MsgNotFound"]); return; }

        dbLic.IsActive = true;
        dbLic.RevocationReason = null;
        dbLic.RevokedAt = null;

        db.LicenseHistories.Add(new LicenseHistory {
            LicenseId = l.Id,
            Action = HistoryActions.Reactivated,
            PerformedBy = "Admin"
        });

        await db.SaveChangesAsync();
        Toast.ShowSuccess(L["Licenses_MsgReactivated"]);
        await LoadData();
    }
    
    private async Task BeginSeatUnlink(License license, LicenseSeat seat)
    {
        if (!seat.IsActive)
        {
            await DeleteSeat(seat);
            return;
        }

        licenseForSeatUnlink = license;
        seatToUnlink = seat;
        seatUnlinkConfirmationText = "";
    }

    private void CancelSeatUnlink()
    {
        seatToUnlink = null;
        licenseForSeatUnlink = null;
        seatUnlinkConfirmationText = "";
    }

    private async Task ConfirmSeatUnlink()
    {
        if (seatToUnlink == null || !IsStrongConfirmationValid(seatUnlinkConfirmationText)) return;

        var seat = seatToUnlink;
        CancelSeatUnlink();
        await DeleteSeat(seat);
    }

    private async Task DeleteSeat(LicenseSeat seat)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var dbSeat = await db.LicenseSeats
            .Include(s => s.License)
                .ThenInclude(l => l!.Seats)
            .FirstOrDefaultAsync(s => s.Id == seat.Id);
        if (dbSeat == null) { Toast.ShowError(L["Resets_MsgNotFound"]); return; }
        if (!dbSeat.IsActive) { Toast.ShowInfo(L["Licenses_MsgSeatAlreadyUnlinked"]); await LoadData(); return; }

        // On ne supprime plus, on délie (historisation)
        dbSeat.IsActive = false;
        dbSeat.UnlinkedAt = DateTime.UtcNow;
        if (dbSeat.License != null)
            SyncLegacyHardwareStateFromSeats(dbSeat.License);

        var historyMsg = L["Licenses_Action_UnlinkedManual"].Value.Replace("{0}", dbSeat.HardwareId);

        db.LicenseHistories.Add(new LicenseHistory {
            LicenseId = dbSeat.LicenseId,
            Action = HistoryActions.UnlinkedManual,
            Details = historyMsg,
            PerformedBy = "Admin"
        });

        await db.SaveChangesAsync();
        Toast.ShowSuccess(L["Licenses_MsgSeatUnlinked"]);
        await LoadData();
    }

    private static void SyncLegacyHardwareStateFromSeats(License license)
    {
        var activeSeat = license.Seats
            .Where(s => s.IsActive)
            .OrderByDescending(s => s.LastCheckInAt)
            .ThenByDescending(s => s.FirstActivatedAt)
            .FirstOrDefault();

        license.HardwareId = activeSeat?.HardwareId;
        license.ActivationDate = activeSeat?.FirstActivatedAt;

        if (activeSeat == null)
            license.RecoveryCount = 0;
    }

