@code {
    private List<License> LicensesList = new();
    private List<Product> Products = new();
    private List<LicenseType> LicenseTypes = new();

    // Stats globales
    private int statTotal, statActive, statExpired, statRevoked, statIssued;
    private HashSet<string> bannedHwids = new(StringComparer.OrdinalIgnoreCase);
    private List<(string Name, string Email)> ExistingClients = new();

    private bool showCreate = false;
    private string SelectedProductId = "";
    private string SelectedTypeId = "";
    private bool isSelectedTypeAnonymous = false;
    private string NewClientName = "";
    private string NewClientEmail = "";
    private int? newValidityDays = 365;
    private int newMaxSeats = 1;
    private string? GeneratedKey;

    private Guid? editingSeatsLicenseId;
    private int editingSeatsValue = 1;

    private Guid? extendingLicenseId;
    private DateTime extendCustomDate = DateTime.UtcNow.AddDays(30);

    private Guid? changingTypeLicenseId;
    private Guid changingTypeNewId;

    private Guid? ExpandedLicenseId;
    private string activeDetailTab = "seats";

    private bool isAuthorized = false;
    private LicenseSeat? seatToUnlink;
    private License? licenseForSeatUnlink;
    private string seatUnlinkConfirmationText = "";
    private string resetConfirmationText = "";
    private string deleteConfirmationText = "";

    // Filtres
    private string searchText = "";
    private string? filterProduct = null;
    private string? filterStatus = null;
    private string? filterType = null;

    // Pagination
    private int CurrentPage = 1;
    private int PageSize = 25;
    private int TotalCount = 0;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    private void StartEditMaxSeats(License l)
    {
        editingSeatsLicenseId = l.Id;
        editingSeatsValue = l.MaxSeats;
    }

    private async Task SaveMaxSeats(License l)
    {
        if (editingSeatsValue < 1) editingSeatsValue = 1;
        using var db = await DbFactory.CreateDbContextAsync();
        var oldValue = l.MaxSeats;

        await db.Licenses.Where(x => x.Id == l.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.MaxSeats, editingSeatsValue));

        db.Set<LicenseHistory>().Add(new LicenseHistory
        {
            LicenseId = l.Id,
            Action = "MAX_SEATS_CHANGED",
            Details = $"MaxSeats: {oldValue} → {editingSeatsValue}",
            PerformedBy = "Admin"
        });
        await db.SaveChangesAsync();

        l.MaxSeats = editingSeatsValue;
        editingSeatsLicenseId = null;
        Toast.ShowSuccess($"MaxSeats: {oldValue} → {editingSeatsValue}");
    }

    private void StartChangeType(License l)
    {
        changingTypeLicenseId = l.Id;
        changingTypeNewId = l.LicenseTypeId;
    }

    private async Task SaveLicenseType(License l)
    {
        if (changingTypeNewId == l.LicenseTypeId)
        {
            changingTypeLicenseId = null;
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var newType = await db.LicenseTypes.Include(t => t.CustomParams).FirstOrDefaultAsync(t => t.Id == changingTypeNewId);
        if (newType == null) { Toast.ShowError("Type introuvable"); return; }

        var oldTypeName = l.Type?.Name ?? l.Type?.Slug ?? "?";
        await db.Licenses.Where(x => x.Id == l.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.LicenseTypeId, changingTypeNewId));

        db.Set<LicenseHistory>().Add(new LicenseHistory
        {
            LicenseId = l.Id,
            Action = "TYPE_CHANGED",
            Details = $"Type: {oldTypeName} → {newType.Name}",
            PerformedBy = "Admin"
        });
        await db.SaveChangesAsync();

        l.LicenseTypeId = newType.Id;
        l.Type = newType;
        changingTypeLicenseId = null;
        Toast.ShowSuccess($"Type: {oldTypeName} → {newType.Name}");
    }

    private async Task ExtendLicense(License l, int days)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var baseDate = l.ExpirationDate ?? DateTime.UtcNow;
        if (baseDate < DateTime.UtcNow) baseDate = DateTime.UtcNow;
        var oldExpiry = l.ExpirationDate?.ToString("dd/MM/yyyy HH:mm") ?? "Lifetime";
        var newExpiry = baseDate.AddDays(days);

        await db.Licenses.Where(x => x.Id == l.Id)
            .ExecuteUpdateAsync(s => s
                .SetProperty(x => x.ExpirationDate, newExpiry)
                .SetProperty(x => x.IsActive, true));

        db.Set<LicenseHistory>().Add(new LicenseHistory
        {
            LicenseId = l.Id,
            Action = "EXTENDED",
            Details = $"Expiration: {oldExpiry} → {newExpiry:dd/MM/yyyy HH:mm} (+{days}j)",
            PerformedBy = "Admin"
        });
        await db.SaveChangesAsync();

        l.ExpirationDate = newExpiry;
        l.IsActive = true;
        extendingLicenseId = null;
        Toast.ShowSuccess($"+{days}j → {TZ.ToLocal(newExpiry):dd/MM/yyyy HH:mm}");
    }

    private async Task ExtendLicenseToDate(License l)
    {
        if (extendCustomDate <= DateTime.UtcNow)
        {
            Toast.ShowError(L["Licenses_ExtendDateInvalid"].Value);
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var oldExpiry = l.ExpirationDate?.ToString("dd/MM/yyyy HH:mm") ?? "Lifetime";
        var newExpiry = DateTime.SpecifyKind(extendCustomDate, DateTimeKind.Utc);

        await db.Licenses.Where(x => x.Id == l.Id)
            .ExecuteUpdateAsync(s => s
                .SetProperty(x => x.ExpirationDate, newExpiry)
                .SetProperty(x => x.IsActive, true));

        db.Set<LicenseHistory>().Add(new LicenseHistory
        {
            LicenseId = l.Id,
            Action = "EXTENDED",
            Details = $"Expiration: {oldExpiry} → {newExpiry:dd/MM/yyyy HH:mm} (date personnalisée)",
            PerformedBy = "Admin"
        });
        await db.SaveChangesAsync();

        l.ExpirationDate = newExpiry;
        l.IsActive = true;
        extendingLicenseId = null;
        Toast.ShowSuccess($"→ {TZ.ToLocal(newExpiry):dd/MM/yyyy HH:mm}");
    }

    private void OnTypeSelected(ChangeEventArgs e)
    {
        SelectedTypeId = e.Value?.ToString() ?? "";
        isSelectedTypeAnonymous = false;
        if (Guid.TryParse(SelectedTypeId, out var typeId))
        {
            var lt = LicenseTypes.FirstOrDefault(t => t.Id == typeId);
            if (lt != null)
            {
                newMaxSeats = lt.DefaultMaxSeats;
                newValidityDays = lt.DefaultDurationDays;
                SelectedProductId = lt.ProductId.ToString();
                isSelectedTypeAnonymous = lt.AllowAnonymous;
                if (isSelectedTypeAnonymous)
                {
                    NewClientName = "";
                    NewClientEmail = "";
                }
            }
        }
    }

    private void OnClientNameChanged(ChangeEventArgs e)
    {
        NewClientName = e.Value?.ToString() ?? "";
        var match = ExistingClients.FirstOrDefault(c => c.Name == NewClientName);
        if (!string.IsNullOrEmpty(match.Name))
        {
            NewClientEmail = match.Email;
        }
    }

    private bool CanDeleteSelectedLicense =>
