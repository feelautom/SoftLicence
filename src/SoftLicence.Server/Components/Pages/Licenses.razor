    private string GetHistoryDetailsDisplay(LicenseHistory entry)
    {
        if (string.IsNullOrWhiteSpace(entry.Details))
            return string.Empty;

        var details = entry.Details;
        if (entry.Action == HistoryActions.UnlinkedApi && !IsAdminApi(entry.PerformedBy))
        {
            var clientUnlinkText = L["Licenses_Detail_UnlinkedClientApiVerb"].Value;
            details = details
                .Replace("délié via Code Reset API", clientUnlinkText, StringComparison.OrdinalIgnoreCase)
                .Replace("unlinked via API Reset Code", clientUnlinkText, StringComparison.OrdinalIgnoreCase);
        }

        if (entry.Action == HistoryActions.AutoUnlinkedProductScope)
            return L["Licenses_Detail_AutoUnlinkedProductScope"].Value;

        return details;
    }

