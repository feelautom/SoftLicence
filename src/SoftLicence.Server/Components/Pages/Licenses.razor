    private async Task ResetAllSeats()
    {
        if (licenseToReset == null) return;
        if (!IsStrongConfirmationValid(resetConfirmationText)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var dbLic = await db.Licenses.Include(l => l.Seats)
            .FirstOrDefaultAsync(l => l.Id == licenseToReset.Id);
        if (dbLic == null) { Toast.ShowError(L["Resets_MsgNotFound"]); licenseToReset = null; return; }

        int count = 0;
        foreach (var seat in dbLic.Seats.Where(s => s.IsActive))
        {
            seat.IsActive = false;
            seat.UnlinkedAt = DateTime.UtcNow;
            count++;
        }
        dbLic.HardwareId = null; // Reset v1 compat
        dbLic.ActivationDate = null;
        dbLic.RecoveryCount = 0; // On reset le compteur d'abus lors d'un reset global manuel

        var historyMsg = L["Licenses_Action_GlobalReset"].Value.Replace("{0}", count.ToString());

        db.LicenseHistories.Add(new LicenseHistory {
            LicenseId = dbLic.Id,
            Action = HistoryActions.GlobalReset,
            Details = historyMsg,
            PerformedBy = "Admin"
        });

        await db.SaveChangesAsync();
        Toast.ShowSuccess(L["Licenses_MsgAllSeatsUnlinked"]);
        CancelGlobalReset();
        await LoadData();
    }

    private void ConfirmDelete(License l)
    {
        licenseToDelete = l;
        deleteConfirmationText = "";
    }

    private async Task DeleteLicense()
    {
        if (licenseToDelete == null) return;
        if (!CanDeleteSelectedLicense) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var dbLic = await db.Licenses.Include(l => l.Seats)
            .FirstOrDefaultAsync(l => l.Id == licenseToDelete.Id);
        if (dbLic == null) { Toast.ShowError(L["Resets_MsgNotFound"]); licenseToDelete = null; return; }
        if (dbLic.Seats.Any(s => s.IsActive) && !IsStrongConfirmationValid(deleteConfirmationText)) return;

        // On supprime vraiment les seats liés lors de la suppression de la licence parente
        if (dbLic.Seats != null && dbLic.Seats.Any())
        {
            db.LicenseSeats.RemoveRange(dbLic.Seats);
        }
        db.Licenses.Remove(dbLic);
        await db.SaveChangesAsync();
        Toast.ShowSuccess(L["Licenses_MsgDeleted"]);
        CancelDelete();
        await LoadData();
    }

    private void CancelDelete()
    {
        licenseToDelete = null;
        deleteConfirmationText = "";
    }

