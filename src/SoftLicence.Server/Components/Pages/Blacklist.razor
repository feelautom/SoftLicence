@page "/blacklist"
@inject IDbContextFactory<LicenseDbContext> DbFactory
@inject SoftLicence.Server.Services.SecurityService Security
@inject SoftLicence.Server.Services.AuthService Auth
@inject SoftLicence.Server.Services.ToastService Toast
@inject SoftLicence.Server.Services.TimeZoneService TZ
@using SoftLicence.Server.Data
@using Microsoft.EntityFrameworkCore

<div class="container-fluid animate-fade">
    @if (!isAuthorized)
    {
        <div class="text-center py-5">
            <h2 class="text-white">Access Denied</h2>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="mb-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>
                Hardware ID Blacklist
            </h3>
            <button class="btn btn-danger btn-sm" @onclick="() => showAddForm = !showAddForm">
                @(showAddForm ? "Cancel" : "+ Add to Blacklist")
            </button>
        </div>

        @if (showAddForm)
        {
            <div class="card bg-dark border-danger p-3 mb-4 animate-fade">
                <h5 class="text-danger mb-3">Ban Hardware ID</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="small text-muted">Hardware ID</label>
                        <input class="form-control form-control-sm" @bind="newHwid" placeholder="Ex: E26CD1E15D8E7C64" />
                    </div>
                    <div class="col-md-3">
                        <label class="small text-muted">Product (optional)</label>
                        <select class="form-select form-select-sm" @bind="newProductId">
                            <option value="">All products</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="small text-muted">Reason</label>
                        <input class="form-control form-control-sm" @bind="newReason" placeholder="Piracy, abuse..." />
                    </div>
                    <div class="col-md-2">
                        <label class="small text-muted">Category</label>
                        <select class="form-select form-select-sm" @bind="newCategory">
                            <option value="manual">Manual</option>
                            <option value="quota_abuse">Quota Abuse</option>
                            <option value="debugger">Debugger</option>
                            <option value="piracy">Piracy</option>
                            <option value="outdated_version">Outdated Version</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small text-muted">Expires</label>
                        <select class="form-select form-select-sm" @bind="newExpiry">
                            <option value="permanent">Permanent</option>
                            <option value="7">7 days</option>
                            <option value="30">30 days</option>
                            <option value="90">90 days</option>
                            <option value="365">1 year</option>
                        </select>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-danger btn-sm" @onclick="AddBan" disabled="@string.IsNullOrWhiteSpace(newHwid)">
                        Confirm Ban
                    </button>
                </div>
            </div>
        }

        <div class="card bg-dark border-secondary mb-3 p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">@bannedList.Count(b => b.IsActive) active / @bannedList.Count total</span>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" style="width: 180px" @bind="filterProduct" @bind:after="LoadData">
                        <option value="">All products</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                    <input class="form-control form-control-sm" style="width: 250px" placeholder="Search HWID or reason..." @bind="searchText" @bind:after="LoadData" />
                </div>
            </div>

            @if (bannedList.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    <p>No banned hardware IDs</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-sm align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th>Banned</th>
                                <th>Hardware ID</th>
                                <th>Client</th>
                                <th>Product</th>
                                <th>Status</th>
                                <th>Reason</th>
                                <th>Expires</th>
                                <th>Source</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ban in bannedList)
                            {
                                <tr class="@(!ban.IsActive ? "opacity-50" : "")">
                                    <td class="small text-muted text-nowrap">@TZ.ToLocal(ban.BannedAt).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><code class="text-info">@ban.HardwareId</code></td>
                                    <td>
                                        @if (licensesByHwid.TryGetValue(ban.HardwareId, out var lics) && lics.Count > 0)
                                        {
                                            @foreach (var lic in lics)
                                            {
                                                var badgeColor = lic.IsActive ? "success" : "secondary";
                                                <div style="line-height:1.4">
                                                    <span class="badge bg-@badgeColor" style="font-size:0.6rem">@lic.TypeName</span>
                                                    <small class="text-light">@lic.CustomerName</small>
                                                    @if (!string.IsNullOrEmpty(lic.CustomerEmail))
                                                    {
                                                        <small class="text-muted" style="font-size:0.65rem"> @lic.CustomerEmail</small>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                    <td>
                                        @if (ban.Product != null)
                                        {
                                            <span class="badge border border-secondary text-info">@ban.Product.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning small">All</span>
                                        }
                                    </td>
                                    <td>
                                        @if (ban.IsActive)
                                        {
                                            <span class="badge bg-danger" style="font-size: 0.65rem;">BANNED</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success" style="font-size: 0.65rem;">UNBANNED</span>
                                        }
                                    </td>
                                    <td class="small">@ban.Reason</td>
                                    <td>
                                        @if (ban.ExpiresAt.HasValue)
                                        {
                                            var remaining = ban.ExpiresAt.Value - DateTime.UtcNow;
                                            if (remaining.TotalDays > 1)
                                            {
                                                <span class="small text-warning">@((int)remaining.TotalDays)d left</span>
                                            }
                                            else if (remaining.TotalHours > 0)
                                            {
                                                <span class="small text-warning">@((int)remaining.TotalHours)h left</span>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">Expired</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger" style="font-size: 0.65rem;">PERMANENT</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var cat = ban.BanCategory ?? (ban.PiracySuspectId.HasValue ? "piracy" : ban.Reason.StartsWith("Auto-ban:") ? "outdated_version" : "manual");
                                            var catBadge = cat switch {
                                                "quota_abuse" => ("warning text-dark", "QUOTA"),
                                                "outdated_version" => ("info text-dark", "VERSION"),
                                                "debugger" => ("danger", "DEBUGGER"),
                                                "piracy" => ("danger", "PIRACY"),
                                                _ => ("secondary", "MANUAL")
                                            };
                                        }
                                        <span class="badge bg-@catBadge.Item1" style="font-size: 0.6rem;">@catBadge.Item2</span>
                                    </td>
                                    <td class="text-center">
                                        @if (ban.IsActive)
                                        {
                                            <button class="btn btn-sm btn-outline-success px-2 py-0" @onclick="() => Unban(ban.Id)" title="Unban">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isAuthorized;
    private List<BannedHardwareId> bannedList = new();
    private List<Product> products = new();
    private Dictionary<string, List<BannedHwidLicenseInfo>> licensesByHwid = new();
    private bool showAddForm;

    // Add form
    private string newHwid = "";
    private string newProductId = "";
    private string newReason = "Manual ban";
    private string newCategory = "manual";
    private string newExpiry = "permanent";

    // Filters
    private string filterProduct = "";
    private string searchText = "";

    protected override async Task OnInitializedAsync()
    {
        isAuthorized = await Auth.IsRootAsync();
        if (!isAuthorized) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        products = await db.Products.OrderBy(p => p.Name).ToListAsync();

        var query = db.BannedHardwareIds
            .Include(b => b.Product)
            .AsQueryable();

        if (!string.IsNullOrEmpty(filterProduct) && Guid.TryParse(filterProduct, out var pid))
            query = query.Where(b => b.ProductId == pid || b.ProductId == null);

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s = searchText.Trim().ToLower();
            query = query.Where(b => b.HardwareId.ToLower().Contains(s) || b.Reason.ToLower().Contains(s));
        }

        bannedList = await query.OrderByDescending(b => b.BannedAt).ToListAsync();

        // Cross-reference banned HWIDs with license seats
        var hwids = bannedList.Select(b => b.HardwareId).Distinct().ToList();
        var seats = await db.LicenseSeats.AsNoTracking()
            .Include(s => s.License).ThenInclude(l => l!.Type)
            .Where(s => hwids.Contains(s.HardwareId) && s.IsActive)
            .ToListAsync();

        licensesByHwid = seats.GroupBy(s => s.HardwareId)
            .ToDictionary(g => g.Key, g => g.Select(s => new BannedHwidLicenseInfo
            {
                CustomerName = s.License?.CustomerName ?? "",
                CustomerEmail = s.License?.CustomerEmail ?? "",
                TypeName = s.License?.Type?.Name ?? "",
                IsActive = s.License?.IsActive ?? false
            }).ToList());
    }

    private class BannedHwidLicenseInfo
    {
        public string CustomerName { get; set; } = "";
        public string CustomerEmail { get; set; } = "";
        public string TypeName { get; set; } = "";
        public bool IsActive { get; set; }
    }

    private async Task AddBan()
    {
        var hwid = newHwid.Trim();
        if (string.IsNullOrWhiteSpace(hwid)) return;

        Guid? productId = null;
        if (!string.IsNullOrEmpty(newProductId) && Guid.TryParse(newProductId, out var pid))
            productId = pid;

        DateTime? expiresAt = newExpiry == "permanent" ? null : DateTime.UtcNow.AddDays(int.Parse(newExpiry));

        await Security.BanHardwareIdAsync(hwid, newReason, productId, expiresAt, banCategory: newCategory);
        Toast.ShowSuccess($"Hardware ID {hwid} banned");

        newHwid = "";
        newReason = "Manual ban";
        newCategory = "manual";
        newExpiry = "permanent";
        newProductId = "";
        showAddForm = false;
        await LoadData();
    }

    private async Task Unban(Guid banId)
    {
        await Security.UnbanHardwareIdAsync(banId);
        Toast.ShowSuccess("Hardware ID unbanned");
        await LoadData();
    }
}
