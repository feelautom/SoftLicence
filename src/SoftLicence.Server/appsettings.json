{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RuntimeEnrollment": {
    "Mode": "off"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=softlicence;Username=postgres;Password=CHANGE_ME_DB_PASSWORD"
  },
  "AdminSettings": {
    "Username": "admin",
    "Password": "CHANGE_ME_SECURE_PASSWORD",
    "ApiSecret": "CHANGE_ME_RANDOM_SECRET",
    "LoginPath": "CHANGE_ME_SECRET_LOGIN_PATH",
    "AllowedIps": ""
  },
  "SecuritySettings": {
    "ProtectedInfrastructureIps": ""
  },
  "SmtpSettings": {
    "Host": "smtp.EXAMPLE.COM",
    "Port": 587,
    "Username": "contact@EXAMPLE.COM",
    "Password": "CHANGE_ME_SMTP_PASSWORD",
    "FromEmail": "noreply@EXAMPLE.COM",
    "FromName": "YOUR_COMPANY_NAME Auth"
  },
  "GeoIpSettings": {
    "LicenseKey": "CHANGE_ME_MAXMIND_KEY"
  },
  "RetentionSettings": {
    "AuditLogsDays": 30,
    "TelemetryDays": 0,
    "CleanupEnabled": true,
    "CleanupIntervalHours": 24,
    "AccessLogBatchSize": 1000,
    "AccessLogMaxBatchesPerRun": 100,
    "AccessLogBatchDelayMilliseconds": 100,
    "AccessLogRunBudgetSeconds": 300,
    "AccessLogStatementTimeoutSeconds": 30,
    "AccessLogLockTimeoutMilliseconds": 1000,
    "AccessLogPartitionHorizonDays": 45
  }
}
